#!/usr/bin/env bash
# shedman migrate; retrofit a pre-packaging ShedOS install onto the
# packaged model — or, with --from-arch, adopt an existing Arch
# install into ShedOS without reinstalling.
#
# Target audience: installs dated before the April 2026 packaging
# cut-over (commit 2148ff0), where the system was laid down by the
# ISO's archiso payload as plain dotfiles, with no shedos-* packages
# installed. Running this tool is idempotent; a packaged install
# detects "already packaged" on entry and exits 0.
#
# What it does on a legacy install:
#   1. snapper snapshot (pre-migrate-to-packaged) so the whole thing
#      can be rolled back if anything explodes.
#   2. append the [shedos] fence block to /etc/pacman.conf (same
#      format shedos-system.install emits on fresh install).
#   3. pacman -Syu shedos-meta; brings shedos-keyring, shedos-system,
#      shedos-hyprland, shedos-nvim, shedos-branding, plus the full
#      Arch/AUR stack. .pacnew files land on any /etc collisions.
#   4. shedman config --sync --rebuild-manifest if available, else
#      plain --sync to seed state.
#   5. shedman doctor; sanity check that the system is aligned.
#
# By default the tool runs in dry-run mode: it prints the plan and
# exits 0. Pass --yes to execute. This matches every other shedman
# verb-style subcommand (apply, rollback, etc.).
#
# Testable surface:
#   SHEDOS_MIGRATE_ROOT    synthetic root, defaults to "/". The tool
#                          reads /etc/pacman.conf and pacman -Q under
#                          this prefix so fixtures can stub both.
#   PATH-stubbed pacman / snapper / shedman; fixtures prepend a stub
#                          dir so the tool invokes the stubs in place
#                          of the real binaries.

set -uo pipefail

PROG="shedman migrate"
ROOT=${SHEDOS_MIGRATE_ROOT:-/}
# Strip a trailing slash so $ROOT/etc/... renders without doubling.
ROOT=${ROOT%/}

if [[ "${1:-}" == "--help-summary" ]]; then
    echo "retrofit a pre-packaging ShedOS install onto the packaged model"
    exit 0
fi

if [[ "${1:-}" == "--complete-bash" || "${1:-}" == "--complete-zsh" ]]; then
    printf '%s\n' --yes -y --detect --dry-run -n --from-arch --help -h
    exit 0
fi

usage() {
    cat <<EOF
Usage: $PROG [--detect] [--from-arch] [-n|--dry-run] [-y|--yes] [-h|--help]

Retrofit a pre-packaging ShedOS install onto the packaged model, or
adopt an existing Arch install into ShedOS (--from-arch) without
reinstalling. Idempotent — runs on packaged installs are a fast no-op.

Options:
  --detect        Print the detected state (packaged | legacy) and exit 0.
  --from-arch     Adopt a vanilla Arch install: trust the ShedOS key,
                  add the repo, install shedos-meta, become ShedOS.
                  Your files and packages stay; config defaults land
                  beside any files you already have.
  -n, --dry-run   Print the plan and exit. (default)
  -y, --yes       Execute.
  -h, --help      This message.
EOF
}

log()  { printf '%s: %s\n' "$PROG" "$*"; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die()  { warn "$*"; exit 2; }

# Detection

detect_state() {
    # Two signals: the shedos-system package must be installed via
    # pacman AND /etc/pacman.conf must carry the [shedos] fence block.
    # Either missing → "legacy".
    local conf="$ROOT/etc/pacman.conf"
    local has_pkg=0 has_fence=0
    if pacman -Qq shedos-system >/dev/null 2>&1; then
        has_pkg=1
    fi
    if [[ -f $conf ]] && grep -q '^# >>> shedos <<<' "$conf"; then
        has_fence=1
    fi
    if (( has_pkg && has_fence )); then
        echo packaged
    else
        echo legacy
    fi
}

# Mutations; each function is idempotent and honors $dry_run.

_snapshot() {
    local dry=$1
    if (( dry )); then
        log "(dry-run) snapper create --type single --description 'pre-migrate-to-packaged'"
        return 0
    fi
    if ! command -v snapper >/dev/null 2>&1; then
        warn "snapper not installed; skipping safety snapshot"
        return 0
    fi
    snapper -c root create --type single \
        --description 'pre-migrate-to-packaged' \
        --userdata 'source=shedman-migrate' \
        >/dev/null 2>&1 || warn "snapper snapshot failed (continuing)"
    log "safety snapshot taken"
}

_fence_pacman_conf() {
    local dry=$1
    local conf="$ROOT/etc/pacman.conf"
    if [[ ! -f $conf ]]; then
        die "$conf not found"
    fi
    if grep -q '^# >>> shedos <<<' "$conf"; then
        log "[shedos] fence already present; skipping"
        return 0
    fi
    if (( dry )); then
        log "(dry-run) append [shedos] fence block to $conf"
        return 0
    fi
    cat >>"$conf" <<'EOF'

# >>> shedos <<<
# Managed by shedos-system; do not edit between these markers.
# Run `pacman -R shedos-system` to remove automatically.
[shedos]
SigLevel = Required DatabaseRequired
Server = https://repo.shedos.org/stable/$arch
# <<< shedos >>>
EOF
    log "appended [shedos] fence to $conf"
}

_remove_legacy_hyprlock() {
    local dry=$1
    if ! pacman -Qq hyprlock >/dev/null 2>&1; then
        return 0
    fi
    if (( dry )); then
        log "(dry-run) pacman -Rdd --noconfirm hyprlock"
        return 0
    fi
    log "removing hyprlock (superseded by shedos-screensaver)"
    pacman -Rdd --noconfirm hyprlock \
        || warn "pacman -Rdd hyprlock exited non-zero; continuing"
}

_refresh_mirrorlist() {
    local dry=$1
    local script="$ROOT/usr/lib/shedos/refresh-mirrorlist.sh"
    if [[ ! -x $script ]]; then
        # Pre-cutover systems may not have the helper yet; reflector
        # alone is enough for the first pacman run.
        script=""
    fi
    if ! command -v reflector >/dev/null 2>&1; then
        warn "reflector not on PATH; using whatever mirrorlist is already there"
        return 0
    fi
    if (( dry )); then
        log "(dry-run) refresh /etc/pacman.d/mirrorlist via reflector"
        return 0
    fi
    log "refreshing /etc/pacman.d/mirrorlist (reflector)"
    if [[ -n $script ]]; then
        "$script" || warn "reflector exited non-zero; continuing"
    else
        reflector --save /etc/pacman.d/mirrorlist --sort rate \
                  --latest 20 --protocol https --age 12 --threads 5 \
            || warn "reflector exited non-zero; continuing"
    fi
}

_pacman_install_meta() {
    local dry=$1
    if (( dry )); then
        log "(dry-run) pacman -Syu --noconfirm shedos-meta"
        return 0
    fi
    pacman -Syu --noconfirm shedos-meta \
        || die "pacman -Syu shedos-meta failed"
    log "installed shedos-meta"
}

_install_aur_pkgs() {
    local dry=$1
    local dir="$ROOT/usr/share/shedos/aur-pkgs"
    if [[ ! -d $dir ]]; then
        warn "$dir not found; skipping bundled AUR package install"
        return 0
    fi
    shopt -s nullglob
    local pkgs=("$dir"/*.pkg.tar.zst)
    shopt -u nullglob
    if (( ${#pkgs[@]} == 0 )); then
        log "$dir is empty; nothing to install"
        return 0
    fi

    if (( dry )); then
        log "(dry-run) pacman -U --noconfirm --needed --ask=4 $dir/*.pkg.tar.zst"
        return 0
    fi
    log "installing bundled AUR packages (fingerprint TOD stack)"
    for p in "${pkgs[@]}"; do
        log "  → ${p##*/}"
    done
    if ! pacman -U --noconfirm --needed --ask=4 "${pkgs[@]}" 2>&1 \
            | sed 's/^/shedman migrate: /'; then
        warn "pacman -U exited non-zero; some bundled AUR packages may not have installed"
        warn "  rerun later with: sudo pacman -U $dir/*.pkg.tar.zst"
    fi
}

_seed_sync_state() {
    local dry=$1
    if (( dry )); then
        log "(dry-run) shedman config --sync --yes"
        return 0
    fi
    if ! command -v shedman >/dev/null 2>&1; then
        warn "shedman not on PATH (expected after shedos-meta install)"
        return 1
    fi
    shedman config --sync --yes \
        || warn "shedman config --sync exited non-zero (continuing)"
    log "seeded dotfile sync state"
}

_verify_with_doctor() {
    local dry=$1
    if (( dry )); then
        log "(dry-run) shedman doctor"
        return 0
    fi
    if ! command -v shedman >/dev/null 2>&1; then
        warn "shedman not available; skipping doctor check"
        return 0
    fi
    if shedman doctor >/dev/null 2>&1; then
        log "shedman doctor: aligned"
    else
        warn "shedman doctor reports drift; investigate with 'shedman doctor --diff'"
    fi
}

# --from-arch mutations

# Rotations append the new fingerprint here together with the keyring
# (docs/key-rotation.md); verify-then-trust, never blind-add. The
# downloaded keyring may contain several keys during a rotation
# window — every one of them must be on this list.
SHEDOS_KEY_FPRS=(
    2095CF9F5C6DDED8ACF8583D99B38D3CAE22D820
)
SHEDOS_KEY_URL=https://repo.shedos.org/shedos.gpg

_check_arch_base() {
    [[ -f "$ROOT/etc/arch-release" ]] \
        || die "--from-arch needs an Arch Linux base (/etc/arch-release missing)"
    if pacman -Qq manjaro-release >/dev/null 2>&1; then
        die "Manjaro's delayed repositories aren't compatible with ShedOS packages"
    fi
}

_check_filesystem() {
    local fstype
    fstype=$(findmnt -no FSTYPE / 2>/dev/null || echo unknown)
    if [[ $fstype == btrfs ]]; then
        log "root is btrfs — snapshots and rollback fully available"
        return 0
    fi
    warn "root filesystem is $fstype, not btrfs:"
    warn "  pre-upgrade snapshots, shedman rollback, and boot"
    warn "  auto-recovery will be UNAVAILABLE on this machine."
    warn "  Everything else works; a fresh ShedOS install gets you"
    warn "  the full safety story."
}

_fpr_known() {
    local fp known
    fp=$1
    for known in "${SHEDOS_KEY_FPRS[@]}"; do
        [[ $fp == "$known" ]] && return 0
    done
    return 1
}

_bootstrap_key() {
    local dry=$1
    if pacman-key --list-keys "${SHEDOS_KEY_FPRS[0]}" >/dev/null 2>&1; then
        log "ShedOS signing key already trusted; skipping"
        return 0
    fi
    if (( dry )); then
        log "(dry-run) fetch $SHEDOS_KEY_URL, verify fingerprints,"
        log "          pacman-key --add + --lsign-key"
        return 0
    fi
    local tmp
    tmp=$(mktemp)
    if ! curl -fsSL --max-time 30 "$SHEDOS_KEY_URL" -o "$tmp"; then
        rm -f "$tmp"
        die "could not download the ShedOS signing key"
    fi
    # Every primary key in the download must be on the pinned list —
    # one rogue key smuggled beside a valid one is a refusal.
    local fps fp
    fps=$(gpg --show-keys --with-colons "$tmp" 2>/dev/null \
        | awk -F: '$1 == "pub" { want=1; next } want && $1 == "fpr" { print $10; want=0 }')
    [[ -n $fps ]] || { rm -f "$tmp"; die "no keys in downloaded keyring"; }
    while IFS= read -r fp; do
        _fpr_known "$fp" \
            || { rm -f "$tmp"; die "unexpected key $fp in keyring — refusing to trust"; }
    done <<<"$fps"
    pacman-key --add "$tmp" || { rm -f "$tmp"; die "pacman-key --add failed"; }
    rm -f "$tmp"
    while IFS= read -r fp; do
        pacman-key --lsign-key "$fp" || die "pacman-key --lsign-key $fp failed"
    done <<<"$fps"
    log "ShedOS signing key(s) verified and trusted"
}

_handle_display_manager() {
    local dry=$1
    local link="$ROOT/etc/systemd/system/display-manager.service"
    local current=""
    [[ -L $link ]] && current=$(basename "$(readlink "$link")")
    if [[ -z $current || $current == greetd.service ]]; then
        return 0
    fi
    if (( dry )); then
        log "(dry-run) switch display manager: disable $current, enable greetd"
        return 0
    fi
    log "switching display manager: $current → greetd"
    systemctl disable "$current" >/dev/null 2>&1 \
        || warn "could not disable $current; you may have two display managers enabled"
    systemctl enable greetd.service >/dev/null 2>&1 \
        || warn "could not enable greetd; enable it manually before rebooting"
    log "your previous desktop stays installed; ShedOS boots its own session"
}

# Arg parse

mode=dry-run
detect_only=0
from_arch=0
while (( $# )); do
    case $1 in
        --detect)    detect_only=1 ;;
        --from-arch) from_arch=1 ;;
        -n|--dry-run)   mode=dry-run ;;
        -y|--yes)    mode=yes ;;
        -h|--help)   usage; exit 0 ;;
        *)           die "unknown option: $1" ;;
    esac
    shift
done

state=$(detect_state)

if (( detect_only )); then
    echo "$state"
    exit 0
fi

if [[ $state == packaged ]]; then
    log "already packaged — nothing to do."
    exit 0
fi

dry=0
[[ $mode == dry-run ]] && dry=1

if (( from_arch )); then
    # Adopt a vanilla Arch install.
    _check_arch_base
    if (( dry )); then
        log "adopting this Arch install into ShedOS — plan:"
    else
        log "adopting this Arch install into ShedOS"
    fi
    _check_filesystem
    _snapshot "$dry"
    _bootstrap_key "$dry"
    _fence_pacman_conf "$dry"
    _refresh_mirrorlist "$dry"
    _pacman_install_meta "$dry"
    _install_aur_pkgs "$dry"
    _handle_display_manager "$dry"
    _seed_sync_state "$dry"
    _verify_with_doctor "$dry"
    if (( dry )); then
        log "dry-run complete. Re-run with --from-arch --yes to execute."
    else
        log "adoption complete. Review any .pacnew/.shedosnew files"
        log "(shedman config --review), then reboot into ShedOS."
    fi
    exit 0
fi

# Plan + execute (legacy pre-packaging ShedOS)

if (( dry )); then
    log "detected legacy (pre-packaging) install"
    log "plan:"
else
    log "detected legacy install; executing migration"
fi

_snapshot "$dry"
_bootstrap_key "$dry"
_fence_pacman_conf "$dry"
_refresh_mirrorlist "$dry"
_remove_legacy_hyprlock "$dry"
_pacman_install_meta "$dry"
_install_aur_pkgs "$dry"
_seed_sync_state "$dry"
_verify_with_doctor "$dry"

if (( dry )); then
    log "dry-run complete. Re-run with --yes to execute."
else
    log "migration complete. You may want to reboot."
fi
exit 0
