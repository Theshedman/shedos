+    // and renderdata.fadeAlpha to 1 (Renderer.cpp:587-590), bypassing every
+    // window/workspace alpha multiplier. Hyprland's own decorations and
+    // rounding are also skipped in standalone mode, which is fine — the
+    // overview draws its own selection border.
+    (*(tRenderWindow)pRenderWindow)(g_pHyprRenderer.get(), pWindow, pMonitor, time, true, Render::RENDER_PASS_ALL, false, true);
 
     // restore values for normal window render
     pWindow->m_workspace = oWorkspace;
