# Maintainer: ShedOS <https://github.com/theshedman/shedos>
#
# Workspace overview plugin for Hyprland — Mission-Control-style
# horizontal workspace strip at the top of the screen, with live
# window previews and drag-to-move-between-workspaces support.
#
# Source: Petar546's fork of KZDKM/Hyprspace, pinned to the commit
# whose porting work to Hyprland 0.55 we validated.
# Patch: ShedOS-local fixes that complete Petar546's mid-port:
#   - register the overview:toggle / overview:open / overview:close
#     dispatchers (Petar546 wrote the functions but never wired them)
#   - subscribe reloadConfig() to config.reloaded events (similarly
#     defined-but-not-wired) so user-set plugin:overview:* config
#     keys actually apply
#   - drop the gap-rule override block in updateLayout() that hits a
#     static-CConfigValue null-deref on 0.55

pkgname=shedos-hyprland-plugin-hyprspace
pkgver=0.55.0
pkgrel=1
pkgdesc='Workspace-overview plugin for Hyprland (Hyprspace), patched against ShedOS-shipped Hyprland'
arch=('x86_64')
url='https://github.com/Petar546/Hyprspace'
license=('BSD-3-Clause')

depends=(
    'hyprland'
    'gcc-libs'
    'glibc'
    'pixman'
    'libdrm'
    'pango'
    'libinput'
    'systemd-libs'
    'wayland'
    'libxkbcommon'
)

makedepends=(
    'gcc'
    'make'
    'pkgconf'
    'git'
    'hyprland-protocols'
)

_commit='73d3e25c4bc32dfba351a2b4614ab007eee2cee7'

source=(
    "git+https://github.com/Petar546/Hyprspace.git#commit=$_commit"
    '0001-shedos-fixes.patch'
)
sha256sums=('SKIP'
            'SKIP')

prepare() {
    cd "$srcdir/Hyprspace"
    patch -p1 < ../0001-shedos-fixes.patch
}

build() {
    cd "$srcdir/Hyprspace"
    make all
}

package() {
    install -Dm644 "$srcdir/Hyprspace/Hyprspace.so" \
        "$pkgdir/usr/lib/hyprland/Hyprspace.so"
}
