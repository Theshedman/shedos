# shellcheck shell=bash
# shedos-hyprland install scriptlet


_seed_bash_skel() {
    # /etc/skel/.bashrc and .bash_profile are owned by the bash package,
    # so they cannot ride this package's payload. Seed ours over the
    # stock pair from the defaults mirror; bash lists them as backup
    # files, so bash upgrades leave these in place.
    local d=/usr/share/shedos/hyprland/defaults f
    for f in .bashrc .bash_profile; do
        [[ -f $d/$f ]] && install -m644 "$d/$f" "/etc/skel/$f"
    done
}

_strip_live_artifacts() {
    # Skip in the live ISO build chroot and on the running live ISO —
    # /etc/calamares ships only on the live ISO and is excluded from the
    # installed system via unpackfs-exclude.conf. Without this guard, the
    # hook strips /home/shedos/.bash_profile from the airootfs during pacstrap.
    [[ -d /etc/calamares ]] && return 0

    # 1. Per-user .bash_profile: revert from the live-ISO auto-installer
    #    variant back to the skeleton baseline. Older installs carried the
    #    same launcher in .zprofile; revert that spelling too.
    local marker='Auto-start graphical installer on tty1'
    local home f
    while IFS=: read -r _ _ _ _ _ home _; do
        for f in "$home/.bash_profile" "$home/.zprofile"; do
            [[ -f "$f" ]] || continue
            grep -qF "$marker" "$f" 2>/dev/null || continue
            install -Dm644 "/etc/skel/${f##*/}" "$f" 2>/dev/null || true
        done
    done < <(getent passwd | awk -F: '$3 >= 1000 && $3 < 65000 && $6 ~ /^\/home\//')

    # 2. /etc/profile.d/shedos-live.sh: the live-ISO welcome banner.
    #    Calamares' unpackfs-exclude.conf skips this file on fresh
    #    installs done with the post-fix installer, but earlier
    #    installs (and ones done before the exclude entry shipped)
    #    have it on disk and source it on every interactive bash
    #    login; which leaves the banner text in the VT's vcs buffer,
    #    visible as console-text flashes during DRM-master handoffs
    #    (Plymouth→cage, cage→Hyprland, Hyprland→Plymouth-shutdown).
    #    Removing the file eliminates the source; clearing
    #    /dev/vcs1 + /dev/vcs2 wipes the leftover text already in
    #    those framebuffer text buffers so the next gap paints empty.
    if [[ -f /etc/profile.d/shedos-live.sh ]]; then
        rm -f /etc/profile.d/shedos-live.sh
        # Best-effort buffer wipe: empty the vcs of the typical
        # active VTs (1 and 2). Failures (e.g. when running inside
        # pacstrap with no /dev/vcs) are silently ignored.
        : > /dev/vcs1 2>/dev/null || true
        : > /dev/vcs2 2>/dev/null || true
    fi
}

_migrate_surface_enablement() {
    # Migrate existing users off the old `--global enable` model: seed each real
    # user's wants/ from skel, drop the stale /etc/systemd/user globals. Guarded
    # off the live build, where the seed hook already copies skel. Idempotent.
    [[ -d /etc/calamares ]] && return 0
    local skel_wants=/etc/skel/.config/systemd/user/graphical-session.target.wants
    [[ -d $skel_wants ]] || return 0

    local uid gid home user_wants link name
    while IFS=: read -r _ _ uid gid _ home _; do
        [[ -d $home ]] || continue
        user_wants="$home/.config/systemd/user/graphical-session.target.wants"
        install -d -o "$uid" -g "$gid" "$user_wants" 2>/dev/null || continue
        for link in "$skel_wants"/*; do
            name=${link##*/}
            [[ -e "$user_wants/$name" || -L "$user_wants/$name" ]] && continue
            cp -P "$link" "$user_wants/$name" 2>/dev/null || continue
            chown -h "$uid:$gid" "$user_wants/$name" 2>/dev/null || true
        done
    done < <(getent passwd | awk -F: '$3 >= 1000 && $3 < 65000 && $6 ~ /^\/home\//')

    local global_wants=/etc/systemd/user/graphical-session.target.wants
    [[ -d $global_wants ]] || return 0
    for link in "$skel_wants"/*; do
        rm -f "$global_wants/${link##*/}"
    done
}

post_install() {
    _seed_bash_skel
    _strip_live_artifacts
    _migrate_surface_enablement
    /usr/lib/shedos/sync-lockdead 2>/dev/null || true
    cat <<'EOF'

ShedOS Hyprland profile installed.

For the current user: run `shedman config --sync` to seed the defaults into
your $HOME (or re-run after upgrades — `shedman update` already does this for
you). Files you've edited are never overwritten; conflicts land as
.shedosnew alongside, mirroring pacman's .pacnew convention.

EOF
}

post_upgrade() {
    _seed_bash_skel
    _strip_live_artifacts
    _migrate_surface_enablement
    /usr/lib/shedos/sync-lockdead 2>/dev/null || true
}
