# shedos-hyprland install scriptlet

post_install() {
    cat <<'EOF'

ShedOS Hyprland profile installed.

For the current user: run `shedman config --sync` to seed the defaults into
your $HOME (or re-run after upgrades — `shedman update` already does this for
you). Files you've edited are never overwritten; conflicts land as
.shedosnew alongside, mirroring pacman's .pacnew convention.

EOF
}

post_upgrade() {
    # Nothing system-scoped to do — the sync into $HOME is per-user and runs
    # through `shedman config --sync` / `shedman update`.
    :
}
