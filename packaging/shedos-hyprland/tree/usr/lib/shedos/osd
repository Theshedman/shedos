#!/usr/bin/env bash
# On-screen feedback for the volume/brightness keybinds and the DND
# toggle. mako renders the int:value hint as a progress fill and the
# skel mako config styles [app-name=volume] / [app-name=brightness];
# -p/-r replace the previous popup so a held key slides one bar
# instead of stacking a column of notifications.

set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/shedos-osd"
mkdir -p "$STATE_DIR"

_notify() {
    # _notify <app-name> <body> [extra notify-send args...]
    local app="$1" body="$2"; shift 2
    local id_file="$STATE_DIR/$app.id" last_id=0
    [[ -f "$id_file" ]] && last_id=$(<"$id_file")
    notify-send -e -p -r "$last_id" -a "$app" "$@" -- "$body" \
        >"$id_file" 2>/dev/null || true
}

_volume_osd() {
    local vol muted
    vol=$(pamixer --get-volume) || vol=0
    muted=$(pamixer --get-mute) || muted=false
    if [[ "$muted" == true ]]; then
        _notify volume "Muted" -h int:value:0
    else
        _notify volume "Volume ${vol}%" -h "int:value:${vol}"
    fi
}

_brightness_osd() {
    local cur max pct
    cur=$(brightnessctl get) max=$(brightnessctl max)
    pct=$(( cur * 100 / max ))
    _notify brightness "Brightness ${pct}%" -h "int:value:${pct}"
}

case "${1:-}:${2:-}" in
    volume:up)       pamixer -i 5 || true; _volume_osd ;;
    volume:down)     pamixer -d 5 || true; _volume_osd ;;
    volume:mute)     pamixer -t || true; _volume_osd ;;
    volume:mic)
        pamixer --default-source -t || true
        if [[ "$(pamixer --default-source --get-mute)" == true ]]; then
            _notify volume "Microphone muted"
        else
            _notify volume "Microphone on"
        fi
        ;;
    brightness:up)   brightnessctl -q set +5% || true; _brightness_osd ;;
    brightness:down) brightnessctl -q set 5%- || true; _brightness_osd ;;
    dnd:)
        # Toggle mako's dnd mode. The enable confirmation goes out as
        # critical because [mode=dnd urgency=critical] stays visible —
        # the user always sees which state they just switched to.
        if makoctl mode -t dnd | grep -qx dnd; then
            _notify dnd "Do not disturb on" -u critical
        else
            _notify dnd "Do not disturb off"
        fi
        ;;
    *)
        echo "usage: osd volume up|down|mute|mic / brightness up|down / dnd" >&2
        exit 2
        ;;
esac
