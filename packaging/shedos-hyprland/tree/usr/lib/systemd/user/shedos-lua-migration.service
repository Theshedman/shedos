[Unit]
Description=Move superseded hyprlang configs aside after the Lua migration
After=graphical-session.target
PartOf=graphical-session.target
# Skip entirely once migrated; the script self-gates on the same stamp.
# v2: also sweeps the .shedosbak/.bak backup litter older mechanisms
# left beside the configs, so v1-migrated users get one more pass.
ConditionPathExists=!%h/.local/state/shedos/.hypr-lua-migrated-2

[Service]
Type=oneshot
ExecStart=/usr/libexec/shedos-hyprland/lua-migration
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
