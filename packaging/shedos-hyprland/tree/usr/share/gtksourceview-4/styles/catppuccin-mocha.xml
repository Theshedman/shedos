<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="catppuccin-mocha" name="Catppuccin Mocha" version="1.0">
  <author>ShedOS</author>
  <description>Catppuccin Mocha palette, matching the shedman config --review TUI theme.</description>

  <!-- Palette (single source of truth — mirrored from the TUI's PALETTE). -->
  <color name="base"      value="#1e1e2e"/>
  <color name="mantle"    value="#181825"/>
  <color name="surface0"  value="#313244"/>
  <color name="overlay0"  value="#6c7086"/>
  <color name="text"      value="#cdd6f4"/>
  <color name="rosewater" value="#f5e0dc"/>
  <color name="red"       value="#f38ba8"/>
  <color name="maroon"    value="#eba0ac"/>
  <color name="peach"     value="#fab387"/>
  <color name="yellow"    value="#f9e2af"/>
  <color name="green"     value="#a6e3a1"/>
  <color name="teal"      value="#94e2d5"/>
  <color name="sapphire"  value="#74c7ec"/>
  <color name="blue"      value="#89b4fa"/>
  <color name="mauve"     value="#cba6f7"/>
  <color name="pink"      value="#f5c2e7"/>

  <!-- Editor chrome -->
  <style name="text"                        foreground="text"     background="base"/>
  <style name="selection"                   foreground="text"     background="surface0"/>
  <style name="cursor"                      foreground="rosewater"/>
  <style name="secondary-cursor"            foreground="overlay0"/>
  <style name="current-line"                background="mantle"/>
  <style name="current-line-number"         foreground="text"     background="mantle"     bold="true"/>
  <style name="line-numbers"                foreground="overlay0" background="mantle"/>
  <style name="draw-spaces"                 foreground="overlay0"/>
  <style name="right-margin"                foreground="surface0" background="surface0"/>
  <style name="background-pattern"          background="mantle"/>

  <!-- Bracket matching -->
  <style name="bracket-match"               foreground="text"     background="surface0"   bold="true"/>
  <style name="bracket-mismatch"            foreground="text"     background="red"        bold="true"/>

  <!-- Search -->
  <style name="search-match"                foreground="base"     background="yellow"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="overlay0" italic="true"/>
  <style name="def:shebang"                 foreground="overlay0" italic="true"/>
  <style name="def:doc-comment"             foreground="overlay0" italic="true"/>
  <style name="def:doc-comment-element"     foreground="overlay0" bold="true"/>

  <!-- Constants, literals -->
  <style name="def:constant"                foreground="yellow"/>
  <style name="def:string"                  foreground="green"/>
  <style name="def:special-char"            foreground="pink"/>
  <style name="def:special-constant"        foreground="peach"   bold="true"/>
  <style name="def:number"                  foreground="yellow"/>
  <style name="def:floating-point"          foreground="yellow"/>
  <style name="def:boolean"                 foreground="yellow"/>
  <style name="def:decimal"                 use-style="def:number"/>
  <style name="def:base-n-integer"          use-style="def:number"/>
  <style name="def:complex"                 use-style="def:number"/>

  <!-- Identifiers, functions -->
  <style name="def:identifier"              foreground="text"/>
  <style name="def:variable"                foreground="mauve"/>
  <style name="def:function"                foreground="blue"/>

  <!-- Keywords, statements, types -->
  <style name="def:keyword"                 foreground="mauve"   bold="true"/>
  <style name="def:builtin"                 foreground="red"/>
  <style name="def:statement"               foreground="mauve"/>
  <style name="def:type"                    foreground="yellow"/>
  <style name="def:preprocessor"            foreground="red"     bold="true"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         foreground="text"    bold="true"/>
  <style name="def:inline-code"             foreground="green"/>
  <style name="def:insertion"               foreground="green"   underline="single"/>
  <style name="def:deletion"                foreground="red"     strikethrough="true"/>
  <style name="def:link-text"               foreground="blue"    italic="true"/>
  <style name="def:link-symbol"             foreground="blue"    italic="true"/>
  <style name="def:link-destination"        foreground="blue"    underline="single"/>
  <style name="def:heading"                 foreground="blue"    bold="true"/>
  <style name="def:thematic-break"          foreground="overlay0"/>
  <style name="def:preformatted-section"    foreground="green"/>
  <style name="def:list-marker"             foreground="mauve"/>

  <!-- Diagnostics -->
  <style name="def:error"                   foreground="base"    background="red"        bold="true"/>
  <style name="def:warning"                 foreground="base"    background="yellow"/>
  <style name="def:note"                    foreground="yellow"  bold="true"/>
  <style name="def:underlined"              underline="single"/>
  <style name="def:net-address"             foreground="sapphire" underline="single"/>

  <!-- C / C++ -->
  <style name="c:preprocessor"              foreground="red"     bold="true"/>
  <style name="c:included-file"             foreground="green"/>
  <style name="c:common-defines"            foreground="red"     bold="true"/>

  <!-- Diff -->
  <style name="diff:ignore"                 foreground="overlay0"/>
  <style name="diff:added-line"             foreground="green"/>
  <style name="diff:removed-line"           foreground="red"/>
  <style name="diff:changed-line"           foreground="yellow"/>
  <style name="diff:diff-file"              foreground="blue"    bold="true"/>
  <style name="diff:location"               foreground="mauve"/>
  <style name="diff:special-case"           foreground="peach"   bold="true"/>

  <!-- Shell -->
  <style name="sh:function"                 foreground="blue"/>
  <style name="sh:variable"                 foreground="mauve"/>
  <style name="sh:variable-definition"      foreground="mauve"/>

  <!-- XML / HTML -->
  <style name="xml:attribute-name"          foreground="blue"/>
  <style name="xml:element-name"            foreground="mauve"/>
  <style name="xml:entity"                  foreground="peach"/>
  <style name="xml:processing-instruction"  foreground="red"     bold="true"/>
  <style name="xml:tag"                     foreground="mauve"/>
  <style name="xml:namespace"               foreground="sapphire" bold="true"/>

</style-scheme>
