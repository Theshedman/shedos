#!/bin/bash
# shedman launcher — bring up Walker. Hyprland binds this to Super+D.
# elephant + walker --gapplication-service are started by autostart.conf
# so this is a near-instant dbus toggle into the warm service.

if [[ "${1:-}" == "--help-summary" ]]; then
    echo "open the Walker app launcher"
    exit 0
fi

exec walker "$@"
