#!/bin/bash
# shedman launcher — bring up Walker (rofi-style launcher) with its
# elephant service already warmed. Hyprland binds this to Super+D.

if [[ "${1:-}" == "--help-summary" ]]; then
    echo "open the Walker app launcher"
    exit 0
fi

# Check if uwsm-app is available
if command -v uwsm-app &> /dev/null; then
    # Ensure elephant is running
    if ! pgrep -x elephant > /dev/null; then
        setsid uwsm-app -- elephant &
        sleep 1
    fi

    # Ensure walker service is running
    if ! pgrep -f "walker --gapplication-service" > /dev/null; then
        setsid uwsm-app -- walker --gapplication-service &
        sleep 1
    fi
else
    # Fallback if uwsm not available
    if ! pgrep -x elephant > /dev/null; then
        elephant &
        sleep 1
    fi

    if ! pgrep -f "walker --gapplication-service" > /dev/null; then
        walker --gapplication-service &
        sleep 1
    fi
fi

# Launch walker
exec walker "$@"
