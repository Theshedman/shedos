#!/bin/bash
# shedman launcher; bring up Walker. Hyprland binds this to Super+D.
# elephant + walker --gapplication-service are started by autostart.conf
# so this is a near-instant dbus toggle into the warm service.

case "${1:-}" in
    --help-summary) echo "open the Walker app launcher"; exit 0 ;;
    --complete-bash|--complete-zsh|--complete-fish) exit 0 ;;
    -h|--help)
        echo "Usage: shedman launcher [walker args...]"
        echo "Open the Walker launcher; arguments pass through to walker."
        exit 0 ;;
esac

exec walker "$@"
