#!/usr/bin/env python3
"""shedman keybindings — searchable reference dialog.

Reads the live keybinds from the running compositor (`hyprctl binds
-j`), joins them with display metadata at
/usr/share/shedos-hyprland/keybindings-meta.toml, and renders a
3-column dialog (keybinding · program · description) grouped by
category. Querying the compositor instead of parsing config text means
the dialog is always true to what the keys actually do, whatever
format the config is in. A user-customized bind without a metadata
entry shows up under "Other" with its raw command.

Gestures aren't exposed over hyprctl, so those are read from the
config: hl.gesture(...) blocks in ~/.config/hypr/gestures.lua, plus
legacy `gesture =` lines for sessions still on hyprlang.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Iterable

try:
    import tomllib
except ModuleNotFoundError:  # python <3.11 — Arch ships 3.11+, but be safe
    import tomli as tomllib  # type: ignore

import gi
gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk, Gdk  # noqa: E402


# Legacy hyprlang gesture lines (pre-Lua sessions).
GESTURE_RE = re.compile(r"^\s*gesture\s*=\s*(.+?)\s*$")
# hl.gesture({ ... }) blocks in the Lua config.
GESTURE_BLOCK_RE = re.compile(r"hl\.gesture\s*\(\s*\{(.*?)\}\s*\)", re.S)

META_PATH = Path("/usr/share/shedos-hyprland/keybindings-meta.toml")
CSS_PATH = Path("/usr/share/shedos-hyprland/keybindings-dialog.css")
LOGO_PATH = Path("/usr/share/shedos-hyprland/shedos-s.png")
HYPR_DIR = Path(
    os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
) / "hypr"

CATEGORIES = [
    "Applications",
    "Windows & Tiling",
    "Workspaces",
    "Screenshots",
    "System",
    "Audio & Media",
    "Touchpad gestures",
    "Other",
]
CATEGORY_CSS_CLASS = {
    "Applications": "cat-applications",
    "Windows & Tiling": "cat-windows",
    "Workspaces": "cat-workspaces",
    "Screenshots": "cat-screenshots",
    "System": "cat-system",
    "Audio & Media": "cat-audio",
    "Touchpad gestures": "cat-gestures",
    "Other": "cat-other",
}
MOD_ORDER = {"SUPER": 0, "CTRL": 1, "SHIFT": 2, "ALT": 3}
DIRECTION_LABEL = {
    "horizontal": "←→",
    "vertical":   "↑↓",
    "left":       "←",
    "right":      "→",
    "up":         "↑",
    "down":       "↓",
    "pinchin":    "pinch in",
    "pinchout":   "pinch out",
}


# ─── parsing ──────────────────────────────────────────────────────────


# X11 modifier-mask bits, in MOD_ORDER so the canonical string matches
# the meta TOML's `keys` format. CAPS/MOD2/3/5 bits are ignored.
MODMASK_BITS = ((64, "SUPER"), (4, "CTRL"), (1, "SHIFT"), (8, "ALT"))


def parse_binds() -> dict[str, tuple[str, str]]:
    """Return {canonical_keys: (dispatcher, args)} from the running
    compositor. Hyprland has already expanded any config variables, so
    what comes back is exactly what the keys do."""
    binds: dict[str, tuple[str, str]] = {}
    try:
        out = subprocess.run(
            ["hyprctl", "binds", "-j"],
            capture_output=True, text=True, timeout=5, check=True,
        )
        entries = json.loads(out.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as e:
        print(f"shedman keybindings: hyprctl binds failed: {e}", file=sys.stderr)
        return binds
    for b in entries:
        if b.get("submap"):
            continue
        key = b.get("key") or ""
        if not key and b.get("keycode"):
            key = f"code:{b['keycode']}"
        if not key:
            continue
        modmask = b.get("modmask", 0)
        parts = [name for bit, name in MODMASK_BITS if modmask & bit]
        parts.append(key)
        binds["+".join(parts)] = (b.get("dispatcher", ""), b.get("arg", ""))
    return binds


def _canonical_combo(combo: str) -> str:
    """Normalize a Lua bind combo ("SUPER + SHIFT + Return") to the
    meta TOML key format ("SUPER+SHIFT+Return")."""
    parts = [p.strip() for p in combo.split("+") if p.strip()]
    if not parts:
        return ""
    mods = sorted((p.upper() for p in parts[:-1]),
                  key=lambda x: MOD_ORDER.get(x, 99))
    return "+".join(mods + parts[-1:])


BIND_LUA_RE = re.compile(r"hl\.bind\(\s*([^,]+?),\s*(.+?)\)\s*(?:--.*)?$")


def _action_hint(src: str) -> tuple[str, str]:
    """Best-effort (dispatcher, args) from a Lua bind/gesture action."""
    m = re.search(r'exec_cmd\(\s*(?:"([^"]*)"|\[\[(.*?)\]\])', src)
    if m:
        return ("exec", m.group(1) or m.group(2) or "")
    m = re.search(r'overview\("(\w+)"\)', src)
    if m:
        return (f"overview:{m.group(1)}", "")
    m = re.search(r"hl\.dsp\.([\w.]+)\(", src)
    if m:
        return (m.group(1), "")
    return ("lua", "")


def parse_bind_hints(cfg_dir: Path) -> dict[str, tuple[str, str]]:
    """Under a Lua session every bind comes back from hyprctl as
    `__lua <callback-id>`, which tells a reader nothing. Statically
    scan the config for what each combo does, for fallback display
    when a bind has no metadata entry. Loop-generated binds (the
    workspace numbers) aren't visible here; they're all meta-covered."""
    hints: dict[str, tuple[str, str]] = {}
    for lua in sorted(cfg_dir.glob("*.lua")):
        try:
            text = lua.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            m = BIND_LUA_RE.search(line)
            if not m:
                continue
            combo_src, action_src = m.group(1), m.group(2)
            combo_src = combo_src.replace("mainMod", '"SUPER"')
            # Skip combos still containing variables after the mainMod
            # substitution (the loop-generated workspace binds).
            if re.search(r"\.\.\s*[a-zA-Z_]", combo_src):
                continue
            # Lua `..` concatenates, so the combo is the quoted
            # segments joined as-is.
            combo = _canonical_combo("".join(re.findall(r'"([^"]*)"', combo_src)))
            if combo:
                hints[combo] = _action_hint(action_src)
    return hints


def parse_gestures(cfg_dir: Path) -> dict[str, tuple[str, str]]:
    """Return {fingers:direction: (action, args)} from the config —
    hl.gesture(...) blocks in the Lua modules plus legacy `gesture =`
    lines for sessions still on hyprlang. hyprctl has no gesture
    listing, so the config stays the source here."""
    gestures: dict[str, tuple[str, str]] = {}
    if not cfg_dir.is_dir():
        return gestures
    for conf in sorted(cfg_dir.glob("*.conf")):
        try:
            text = conf.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            stripped = line.lstrip()
            if not stripped or stripped.startswith("#"):
                continue
            m = GESTURE_RE.match(line)
            if not m:
                continue
            parts = [p.strip() for p in m.group(1).split(",")]
            if len(parts) < 3:
                continue
            fingers, direction, action = parts[0], parts[1], parts[2]
            args = ", ".join(parts[3:]) if len(parts) > 3 else ""
            gestures[f"{fingers}:{direction}"] = (action, args)
    for lua in sorted(cfg_dir.glob("*.lua")):
        try:
            text = lua.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for body in GESTURE_BLOCK_RE.findall(text):
            fm = re.search(r"fingers\s*=\s*(\d+)", body)
            dm = re.search(r'direction\s*=\s*"([^"]+)"', body)
            if not (fm and dm):
                continue
            am = re.search(r'action\s*=\s*"([^"]+)"', body)
            if am:
                action, args = am.group(1), ""
                zm = re.search(r"zoom_level\s*=\s*([\d.]+)", body)
                if zm:
                    args = f"zoom {zm.group(1)}"
            else:
                action, args = _action_hint(body)
            gestures[f"{fm.group(1)}:{dm.group(1)}"] = (action, args)
    return gestures


def load_meta(meta_path: Path) -> tuple[dict[str, dict], dict[str, dict]]:
    """Return ({keys: meta}, {gesture: meta}) from the TOML."""
    bind_meta: dict[str, dict] = {}
    gesture_meta: dict[str, dict] = {}
    if not meta_path.is_file():
        return bind_meta, gesture_meta
    try:
        with meta_path.open("rb") as f:
            data = tomllib.load(f)
    except (tomllib.TOMLDecodeError, OSError) as e:
        print(f"shedman keybindings: failed to read {meta_path}: {e}",
              file=sys.stderr)
        return bind_meta, gesture_meta
    for entry in data.get("bind", []):
        keys = entry.get("keys")
        if not keys:
            continue
        bind_meta[keys] = {
            "category": entry.get("category", "Other"),
            "name": entry.get("name", ""),
            "description": entry.get("description", ""),
        }
    for entry in data.get("gesture", []):
        gid = entry.get("gesture")
        if not gid:
            continue
        gesture_meta[gid] = {
            "category": entry.get("category", "Touchpad gestures"),
            "name": entry.get("name", ""),
            "description": entry.get("description", ""),
        }
    return bind_meta, gesture_meta


def compose_rows(
    binds: dict[str, tuple[str, str]],
    gestures: dict[str, tuple[str, str]],
    bind_meta: dict[str, dict],
    gesture_meta: dict[str, dict],
) -> dict[str, list[dict]]:
    """Group rows by category, in CATEGORIES order."""
    grouped: dict[str, list[dict]] = {c: [] for c in CATEGORIES}
    seen_binds: set[str] = set()
    seen_gestures: set[str] = set()
    # Pass 1a: bind meta entries that match a live bind.
    for keys, m in bind_meta.items():
        if keys not in binds:
            continue
        cat = m["category"] if m["category"] in grouped else "Other"
        grouped[cat].append({
            "keys": keys,
            "name": m["name"] or _fallback_name(*binds[keys]),
            "description": m["description"] or "",
        })
        seen_binds.add(keys)
    # Pass 1b: gesture meta entries that match a live gesture.
    for gid, m in gesture_meta.items():
        if gid not in gestures:
            continue
        cat = m["category"] if m["category"] in grouped else "Touchpad gestures"
        grouped[cat].append({
            "gesture": gid,
            "name": m["name"] or _fallback_name(*gestures[gid]),
            "description": m["description"] or "",
        })
        seen_gestures.add(gid)
    # Pass 2a: live binds with no metadata → Other, raw exec as description.
    for keys, (dispatcher, args) in binds.items():
        if keys in seen_binds:
            continue
        grouped["Other"].append({
            "keys": keys,
            "name": _fallback_name(dispatcher, args),
            "description": _fallback_description(dispatcher, args),
        })
    # Pass 2b: live gestures with no metadata → Touchpad gestures, raw.
    for gid, (action, args) in gestures.items():
        if gid in seen_gestures:
            continue
        grouped["Touchpad gestures"].append({
            "gesture": gid,
            "name": _fallback_name(action, args),
            "description": _fallback_description(action, args),
        })
    return grouped


def _fallback_name(dispatcher: str, args: str) -> str:
    if dispatcher == "exec":
        return (args.split() or ["exec"])[0]
    return dispatcher


def _fallback_description(dispatcher: str, args: str) -> str:
    if dispatcher == "exec" and args:
        return args
    return dispatcher


# ─── UI ───────────────────────────────────────────────────────────────


class KeybindingsApp(Gtk.Application):
    def __init__(self, grouped: dict[str, list[dict]]):
        super().__init__(application_id="org.shedos.keybindings",
                         flags=0)
        self.grouped = grouped

    def do_activate(self):
        self._load_css()
        win = KeybindingsWindow(self, self.grouped)
        win.present()

    def _load_css(self):
        if not CSS_PATH.is_file():
            return
        provider = Gtk.CssProvider()
        try:
            provider.load_from_path(str(CSS_PATH))
        except GLib.Error as e:
            print(f"shedman keybindings: CSS load failed: {e}",
                  file=sys.stderr)
            return
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )


class KeybindingsWindow(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application, grouped: dict[str, list[dict]]):
        super().__init__(application=app)
        self.set_title("ShedOS Keybindings")
        self.set_default_size(960, 680)
        self.add_css_class("keybindings-dialog")

        self.grouped = grouped
        self._row_widgets: list[tuple[Gtk.Widget, dict, Gtk.Widget]] = []

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(outer)

        outer.append(self._build_header())
        outer.append(self._build_search())
        outer.append(self._build_list())
        outer.append(self._build_footer())

        # Esc to close. `/` to focus the search.
        ev = Gtk.EventControllerKey()
        ev.connect("key-pressed", self._on_key)
        self.add_controller(ev)

    # ---- header ----

    def _build_header(self) -> Gtk.Widget:
        box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=10,
        )
        box.add_css_class("keybindings-header")

        if LOGO_PATH.is_file():
            image = Gtk.Image.new_from_file(str(LOGO_PATH))
            image.set_pixel_size(28)
            box.append(image)

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label="ShedOS Keybindings", xalign=0.0)
        title.add_css_class("title")
        subtitle = Gtk.Label(label="Press Esc to close · / to search",
                             xalign=0.0)
        subtitle.add_css_class("subtitle")
        text_box.append(title)
        text_box.append(subtitle)
        text_box.set_hexpand(True)
        box.append(text_box)
        return box

    # ---- search ----

    def _build_search(self) -> Gtk.Widget:
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Filter keybindings…")
        self.search.add_css_class("keybindings-search")
        self.search.connect("search-changed", self._on_search_changed)
        return self.search

    # ---- list ----

    def _build_list(self) -> Gtk.Widget:
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.set_vexpand(True)
        self.scrolled.add_css_class("keybindings-list")

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        body.set_margin_start(8)
        body.set_margin_end(8)

        self._empty_label = Gtk.Label(label="No keybindings match")
        self._empty_label.add_css_class("keybindings-empty")
        self._empty_label.set_visible(False)
        body.append(self._empty_label)

        for category in CATEGORIES:
            rows = self.grouped.get(category, [])
            if not rows:
                continue
            section_header = self._build_section_header(category)
            body.append(section_header)
            section_rows: list[Gtk.Widget] = []
            for row in rows:
                row_widget = self._build_row(row)
                body.append(row_widget)
                section_rows.append(row_widget)
                self._row_widgets.append((row_widget, row, section_header))
            # Track section header so it disappears when all rows hidden.
            section_header.section_rows = section_rows  # type: ignore[attr-defined]

        self.scrolled.set_child(body)
        return self.scrolled

    def _build_section_header(self, category: str) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.add_css_class("keybindings-section-header")
        title = Gtk.Label(label=category, xalign=0.0)
        title.add_css_class("keybindings-section-title")
        chip = Gtk.Label(label=category.upper())
        chip.add_css_class("keybindings-section-chip")
        chip.add_css_class(CATEGORY_CSS_CLASS.get(category, "cat-other"))
        box.append(title)
        box.append(chip)
        return box

    def _build_row(self, row: dict) -> Gtk.Widget:
        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        outer.add_css_class("keybindings-row")

        keys_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        keys_box.add_css_class("keybindings-keys")
        if "gesture" in row:
            fingers, _, direction = row["gesture"].partition(":")
            finger_chip = Gtk.Label(label=f"{fingers}-finger")
            finger_chip.add_css_class("keybindings-key-chip")
            keys_box.append(finger_chip)
            dir_chip = Gtk.Label(
                label=DIRECTION_LABEL.get(direction, direction)
            )
            dir_chip.add_css_class("keybindings-key-chip")
            keys_box.append(dir_chip)
        else:
            parts = row["keys"].split("+")
            for i, part in enumerate(parts):
                if i > 0:
                    plus = Gtk.Label(label="+")
                    plus.add_css_class("keybindings-key-plus")
                    keys_box.append(plus)
                chip = Gtk.Label(label=_human_key(part))
                chip.add_css_class("keybindings-key-chip")
                keys_box.append(chip)
        outer.append(keys_box)

        name = Gtk.Label(label=row["name"], xalign=0.0)
        name.add_css_class("keybindings-name")
        name.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        outer.append(name)

        desc = Gtk.Label(label=row["description"], xalign=0.0)
        desc.add_css_class("keybindings-description")
        desc.set_ellipsize(3)
        desc.set_hexpand(True)
        outer.append(desc)
        return outer

    # ---- footer ----

    def _build_footer(self) -> Gtk.Widget:
        label = Gtk.Label(
            label=("Bindings: live from the compositor (hyprctl binds)"
                   "    Names: /usr/share/shedos-hyprland/keybindings-meta.toml"),
            xalign=0.0,
        )
        label.add_css_class("keybindings-footer")
        return label

    # ---- behavior ----

    def _on_key(self, _ctl, keyval, _kc, _state) -> bool:
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if keyval == Gdk.KEY_slash and not self.search.has_focus():
            self.search.grab_focus()
            return True
        return False

    def _on_search_changed(self, entry: Gtk.SearchEntry) -> None:
        query = entry.get_text().strip().lower()
        any_visible = False
        per_section_visibility: dict[Gtk.Widget, bool] = {}
        for row_widget, row_data, section_header in self._row_widgets:
            if query and not _row_matches(row_data, query):
                row_widget.set_visible(False)
            else:
                row_widget.set_visible(True)
                any_visible = True
                per_section_visibility[section_header] = True
        # Hide section headers whose rows are all filtered out.
        for row_widget, _row_data, section_header in self._row_widgets:
            section_header.set_visible(per_section_visibility.get(section_header, False))
        self._empty_label.set_visible(not any_visible)


def _human_key(part: str) -> str:
    return {
        "SUPER": "Super",
        "CTRL": "Ctrl",
        "SHIFT": "Shift",
        "ALT": "Alt",
    }.get(part, part)


def _row_matches(row: dict, query: str) -> bool:
    fields: Iterable[str] = (
        row.get("keys", ""),
        row.get("gesture", ""),
        row.get("name", ""),
        row.get("description", ""),
    )
    return any(query in (f or "").lower() for f in fields)


# ─── entry point ──────────────────────────────────────────────────────


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--help-summary":
        print("show all keybindings in a searchable dialog")
        return 0
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(
            "Usage: shedman keybindings\n"
            "Open a searchable reference dialog showing every Hyprland\n"
            "bind with a human-readable name and description.")
        return 0

    binds = parse_binds()
    # Lua callbacks come back from hyprctl as opaque `__lua <id>`;
    # swap in what the config says the combo does for fallback display.
    hints = parse_bind_hints(HYPR_DIR)
    for keys, (dispatcher, _args) in list(binds.items()):
        if dispatcher == "__lua":
            binds[keys] = hints.get(keys, ("lua", ""))
    gestures = parse_gestures(HYPR_DIR)
    if not binds and not gestures:
        print("shedman keybindings: no binds from the compositor (is "
              f"Hyprland running?) and no gestures in {HYPR_DIR}",
              file=sys.stderr)
        return 1
    bind_meta, gesture_meta = load_meta(META_PATH)
    grouped = compose_rows(binds, gestures, bind_meta, gesture_meta)

    app = KeybindingsApp(grouped)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
