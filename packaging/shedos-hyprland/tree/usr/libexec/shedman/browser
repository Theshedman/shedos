#!/bin/bash
# shedman browser; launch the user's default web browser in a new window.
#
# Resolution order (system-default first so an in-browser "set as default"
# UI takes effect on the next press without the user having to clean up
# their shell environment):
#
#   1. xdg-settings get default-web-browser  (mimeapps.list-backed; what
#      every browser's "Set as default" prompt writes to).
#   2. $BROWSER environment variable          (legacy / power-user override).
#   3. Hardcoded fallback list                (last-resort if neither above
#      yields anything launchable).

case "${1:-}" in
    --help-summary) echo "launch the default web browser"; exit 0 ;;
    --complete-bash|--complete-zsh|--complete-fish) exit 0 ;;
    -h|--help)
        echo "Usage: shedman browser [args...]"
        echo "Launch the default web browser in a new window; args pass through."
        exit 0 ;;
esac

# Map a default-web-browser desktop ID to the binary that ships it, so
# we can pass --new-window directly. Every entry below is a browser that
# accepts --new-window. Unknown desktops fall through to gio/gtk-launch
# without the flag (no regression).
_browser_binary_from_desktop() {
    case "$1" in
        firefox*.desktop|org.mozilla.firefox*.desktop) echo firefox ;;
        google-chrome*.desktop)                        echo google-chrome-stable ;;
        chromium*.desktop)                             echo chromium ;;
        brave-browser*.desktop)                        echo brave ;;
        vivaldi-stable*.desktop)                       echo vivaldi-stable ;;
        microsoft-edge*.desktop)                       echo microsoft-edge-stable ;;
        *)                                             echo "" ;;
    esac
}

# 1. xdg-settings → known binary with --new-window
if command -v xdg-settings >/dev/null 2>&1; then
    desktop=$(xdg-settings get default-web-browser 2>/dev/null || true)
    if [[ -n "$desktop" ]]; then
        binary=$(_browser_binary_from_desktop "$desktop")
        if [[ -n "$binary" ]] && command -v "$binary" >/dev/null 2>&1; then
            exec "$binary" --new-window "$@"
        fi
        # Unknown desktop file; let the .desktop's own Exec= line decide.
        if command -v gio >/dev/null 2>&1; then
            exec gio launch "/usr/share/applications/$desktop" "$@"
        fi
        if command -v gtk-launch >/dev/null 2>&1; then
            exec gtk-launch "${desktop%.desktop}" "$@"
        fi
    fi
fi

# 2. $BROWSER override
if [[ -n "${BROWSER:-}" ]] && command -v "$BROWSER" >/dev/null 2>&1; then
    exec "$BROWSER" --new-window "$@"
fi

# 3. Hardcoded fallback
for browser in google-chrome-stable firefox chromium brave vivaldi-stable; do
    if command -v "$browser" >/dev/null 2>&1; then
        exec "$browser" --new-window "$@"
    fi
done

echo "shedman browser: no browser found (install firefox, chromium, brave, vivaldi-stable, or google-chrome-stable)" >&2
exit 1
