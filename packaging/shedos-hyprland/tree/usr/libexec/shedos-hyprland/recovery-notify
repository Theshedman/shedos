#!/bin/bash
# Tell the user their machine auto-recovered, and how to make it permanent.
# Two kinds of marker land in /etc/shedos/recovered-from:
#   kind=rollback (or no kind) -- the initrd booted a snapshot after repeated
#                                 boot failures (see initrd-recovery.sh).
#   kind=fstab    -- guided emergency recovery made a missing-disk mount
#                    optional so the system could boot (emergency-recovery-ui).
# The marker disappears once the situation is resolved. One notice per boot.
set -u
marker=${SHEDOS_RECOVERED_FROM:-/etc/shedos/recovered-from}
stamp=${SHEDOS_RECOVERY_STAMP:-/run/user/$UID/shedos-recovery-notified}
[[ -f $marker && ! -f $stamp ]] || exit 0

_get() { sed -n "s/^$1=//p" "$marker"; }

# Set TITLE/BODY from the marker (no notify-send here).
_render() {
    local kind; kind=$(_get kind)
    case $kind in
        fstab)
            local targets backup
            targets=$(_get targets); backup=$(_get backup)
            TITLE="ShedOS recovered your boot"
            BODY="A disk your system needed was missing, so ShedOS made ${targets:-some mounts} optional so you could boot. Reconnect or repair the disk, then run: shedman doctor — your previous fstab is saved at ${backup:-a timestamped backup}."
            ;;
        *)
            local snap; snap=$(_get snapshot)
            TITLE="ShedOS recovered from a failed update"
            BODY="Three boots failed, so you are running a safe copy of snapshot #${snap:-?}. Your files are intact. Make it permanent with: sudo shedman rollback ${snap:-<n>}"
            ;;
    esac
}

_render
notify-send --app-name=ShedOS --urgency=critical \
    --icon=system-software-update \
    "$TITLE" "$BODY" 2>/dev/null || exit 0
touch "$stamp"
