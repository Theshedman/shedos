{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 26,
    "modules-left": [
        "custom/shedos-logo",
        "group/workspaces"
    ],
    "custom/shedos-logo": {
        "format": "    ",
        "tooltip-format": "ShedOS"
    },
    "modules-center": [
        "clock",
        "custom/updates",
        "custom/screenrecording-indicator"
    ],
    "modules-right": [
        "group/tray-expander",
        "bluetooth",
        "network",
        "pulseaudio",
        "cpu",
        "custom/health",
        "custom/doctor",
        "custom/conflicts",
        "battery",
        "custom/power"
    ],
    // Custom per-number workspace buttons. hyprland/workspaces' built-in
    // click sends the raw `dispatch workspace N`, which Hyprland 0.55's Lua
    // config rejects as a syntax error; these dispatch the hl.dsp.focus Lua
    // form instead. The group reuses the #workspaces id so the existing
    // container styling applies; /usr/lib/shedos/waybar-workspace supplies
    // the live active/occupied state per button.
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/workspace-1",
            "custom/workspace-2",
            "custom/workspace-3",
            "custom/workspace-4",
            "custom/workspace-5"
        ]
    },
    "custom/workspace-1": {
        "exec": "/usr/lib/shedos/waybar-workspace 1",
        "return-type": "json",
        "restart-interval": 3,
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
    },
    "custom/workspace-2": {
        "exec": "/usr/lib/shedos/waybar-workspace 2",
        "return-type": "json",
        "restart-interval": 3,
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
    },
    "custom/workspace-3": {
        "exec": "/usr/lib/shedos/waybar-workspace 3",
        "return-type": "json",
        "restart-interval": 3,
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
    },
    "custom/workspace-4": {
        "exec": "/usr/lib/shedos/waybar-workspace 4",
        "return-type": "json",
        "restart-interval": 3,
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
    },
    "custom/workspace-5": {
        "exec": "/usr/lib/shedos/waybar-workspace 5",
        "return-type": "json",
        "restart-interval": 3,
        "format": "{}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
    },
    "cpu": {
        "interval": 5,
        "format": "󰍛",
        "on-click": "kitty --class btop -e btop --force-utf"
    },
    "clock": {
        "format": "{:%A %I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "/usr/bin/kitty --class shedos-datetime -e /usr/lib/shedos/run-with-pause.sh /usr/bin/shedman datetime",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks": "<span color='#74c7ec'><b>W{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        }
    },
    "network": {
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "spacing": 1,
        "on-click": "kitty --class impala -e impala"
    },
    "battery": {
        "format": "{icon}",
        "format-discharging": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
        "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
        "interval": 5,
        "on-click": "shedman power",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "overskride"
    },
    "pulseaudio": {
        "format": "{icon}",
        "on-click": "pavucontrol",
        "on-click-right": "pamixer -t",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        }
    },
    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 600,
            "children-class": "tray-group-item"
        },
        "modules": [
            "custom/expand-icon",
            "tray"
        ]
    },
    "custom/expand-icon": {
        "format": "",
        "tooltip": false
    },
    "custom/updates": {
        "exec": "/usr/bin/shedman updates --waybar",
        "interval": 3600,
        "return-type": "json",
        "hide-empty-text": true,
        "on-click": "/usr/bin/kitty --class shedos-update -e /usr/lib/shedos/run-with-pause.sh /usr/bin/shedman update",
        "signal": 8
    },
    "custom/conflicts": {
        "exec": "/usr/bin/shedman conflicts --waybar",
        "interval": 3600,
        "return-type": "json",
        "hide-empty-text": true,
        "on-click": "/usr/bin/kitty --class shedos-review -e /usr/lib/shedos/run-with-pause.sh /usr/bin/shedman config --review",
        "signal": 9
    },
    "custom/health": {
        "exec": "/usr/bin/shedman health --waybar",
        "interval": 300,
        "return-type": "json",
        "hide-empty-text": true,
        "on-click": "/usr/bin/kitty --class btop -e btop --force-utf",
        "signal": 10
    },
    "custom/doctor": {
        "exec": "/usr/bin/shedman doctor --waybar",
        "interval": 900,
        "return-type": "json",
        "hide-empty-text": true,
        "on-click": "/usr/bin/kitty --class shedman-doctor -e /usr/bin/shedman doctor",
        "signal": 12
    },
    "custom/screenrecording-indicator": {
        "on-click": "/usr/bin/shedman screenrecord",
        "exec": "/usr/bin/shedman screenrecord --waybar",
        "interval": 5,
        "signal": 11,
        "return-type": "json"
    },
    "tray": {
        "icon-size": 12,
        "spacing": 17
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "shedman power"
    }
}