# ShedOS Plymouth Boot Theme Script
# Professional image-based implementation (like Ubuntu/Fedora)

# Screen and window setup
Window.SetBackgroundTopColor(0.118, 0.118, 0.180);
Window.SetBackgroundBottomColor(0.118, 0.118, 0.180);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Load the ShedOS logo
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_width / 2 - logo.image.GetWidth() / 2;
logo.y = screen_height / 2 - logo.image.GetHeight() / 2 - 80;
logo.sprite.SetPosition(logo.x, logo.y, 10);

# ========================================
# Image-based spinner (guaranteed to render)
# ========================================
# Load the dot images
dot_blue_image = Image("dot.png");
dot_white_image = Image("dot_white.png");

# Create 8 spinner dots (Blue overlay + White base)
spinner.dots = [];
spinner.white_dots = [];
spinner.angle = 0;
spinner.radius = 35;
spinner.center_x = screen_width / 2;
spinner.center_y = screen_height / 2 + 100;

for (i = 0; i < 8; i++) {
    # Base white dots (always visible or fading in opposite phase)
    spinner.white_dots[i].sprite = Sprite(dot_white_image);
    spinner.white_dots[i].sprite.SetOpacity(0);

    # Blue overlay dots (animated)
    spinner.dots[i].sprite = Sprite(dot_blue_image);
    spinner.dots[i].sprite.SetOpacity(0);
}

# Hide the spinner while the LUKS field is waiting for input; it should only
# turn once the passphrase is accepted and the disk is actually unlocking.
password_active = 0;
# Track whether the user typed in the current attempt. systemd-cryptsetup sends
# Plymouth no message on a wrong password — it just re-asks with an empty field
# — so an empty prompt that FOLLOWS a typed attempt is the only "incorrect"
# signal. A first or untyped prompt (and the redraws Plymouth issues at startup)
# show nothing.
password_typed = 0;

fun refresh_callback() {
    if (password_active) {
        for (i = 0; i < 8; i++) {
            spinner.dots[i].sprite.SetOpacity(0);
            spinner.white_dots[i].sprite.SetOpacity(0);
        }
        if (Plymouth.GetCapslockState()) {
            caps_sprite.SetOpacity(1);
        } else {
            caps_sprite.SetOpacity(0);
        }
        return;
    }

    caps_sprite.SetOpacity(0);
    spinner.angle += 0.06;

    for (i = 0; i < 8; i++) {
        angle = spinner.angle + (i * 3.14159 * 2 / 8);
        
        # Calculate positions
        x = spinner.center_x + Math.Cos(angle) * spinner.radius - dot_blue_image.GetWidth() / 2;
        y = spinner.center_y + Math.Sin(angle) * spinner.radius - dot_blue_image.GetHeight() / 2;
        
        # Calculate wave opacity (0.0 to 1.0)
        wave = (Math.Sin(spinner.angle - i * 0.8) + 1) / 2;
        
        # Blue opacity follows the wave (0.0 to 1.0)
        blue_opacity = 0.2 + 0.8 * wave;
        
        # White opacity is inverse-ish, but let's just keep white as a base
        # "Vanishes to white" -> When blue fades, white should be visible
        # User requested pure white, so we keep opacity at 1.0
        white_opacity = 1.0;
        
        # White base layer (Layer 19)
        spinner.white_dots[i].sprite.SetPosition(x, y, 19);
        spinner.white_dots[i].sprite.SetOpacity(white_opacity);
        
        # Blue top layer (Layer 20)
        spinner.dots[i].sprite.SetPosition(x, y, 20);
        spinner.dots[i].sprite.SetOpacity(blue_opacity);
    }
}

Plymouth.SetRefreshRate(24);
Plymouth.SetRefreshFunction(refresh_callback);

# ========================================
# Password Entry UI (image-based box)
# ========================================

# Load the entry box image
entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = screen_width / 2 - entry.image.GetWidth() / 2;
entry.y = screen_height / 2 + 180;
entry.sprite.SetPosition(entry.x, entry.y, 50);
entry.sprite.SetOpacity(0);

# Label sprite
label.sprite = Sprite();
label.sprite.SetOpacity(0);

# Load white bullet image for password feedback
bullet_image = Image("bullet.png");

# Bullet sprites for password feedback (white dots)
MAX_BULLETS = 32;
bullets = [];
for (i = 0; i < MAX_BULLETS; i++) {
    bullets[i].sprite = Sprite(bullet_image);
    bullets[i].sprite.SetOpacity(0);
}

# Shared message sprite, warm-red under the box (Z above everything). The
# wrong-password error is driven by the password_typed gate in
# display_password_callback (the crypttab boot path sends no Plymouth message);
# message_callback below stays registered only to cover any future
# display-message path.
message_sprite = Sprite();
message_sprite.SetPosition(0, 0, 100);
message_sprite.SetOpacity(0);

# Caps Lock indicator, amber, above the label — toggled live in
# refresh_callback off Plymouth.GetCapslockState() so a forgotten Caps Lock
# can't silently wreck a case-sensitive passphrase or recovery key.
caps_sprite = Sprite();
caps_image = Image.Text("⇪  Caps Lock is on", 1.0, 0.8, 0.3, 1);
caps_sprite.SetImage(caps_image);
caps_sprite.SetPosition(screen_width / 2 - caps_image.GetWidth() / 2, entry.y - 62, 100);
caps_sprite.SetOpacity(0);

fun message_callback(text) {
    if (text == "") {
        message_sprite.SetOpacity(0);
        return;
    }
    my_image = Image.Text(text, 0.95, 0.45, 0.45, 1);
    message_sprite.SetImage(my_image);
    message_sprite.SetX(screen_width / 2 - my_image.GetWidth() / 2);
    message_sprite.SetY(entry.y + entry.image.GetHeight() + 16);
    message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
    message_sprite.SetOpacity(0);
}

Plymouth.SetMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

fun display_normal_callback() {
    global.password_active = 0;
    # Clear the error in the spinner/normal phase so it can't linger past a
    # correct unlock. A wrong password re-asks immediately after and the
    # password_typed gate re-shows it, so this never swallows a real error.
    message_sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
    label.sprite.SetOpacity(0);
    for (i = 0; i < MAX_BULLETS; i++) {
        bullets[i].sprite.SetOpacity(0);
    }
}

fun display_password_callback(prompt, num_bullets) {
    global.password_active = 1;

    # Show the entry box
    entry.sprite.SetOpacity(1);

    # Show the wrong-password error only on an empty prompt that FOLLOWS a typed
    # attempt (a rejected password). Typing clears it; a first prompt and the
    # repeated empty redraws Plymouth issues at startup never show it — so it
    # never appears by default and never lingers past a correct unlock.
    if (num_bullets > 0) {
        global.password_typed = 1;
        message_sprite.SetOpacity(0);
    } else if (password_typed) {
        global.password_typed = 0;
        err_image = Image.Text("Incorrect password, try again", 0.95, 0.45, 0.45, 1);
        message_sprite.SetImage(err_image);
        message_sprite.SetX(screen_width / 2 - err_image.GetWidth() / 2);
        message_sprite.SetY(entry.y + entry.image.GetHeight() + 16);
        message_sprite.SetOpacity(1);
    } else {
        message_sprite.SetOpacity(0);
    }

    # Show label - always show helpful LUKS message
    label_text = "Enter LUKS password to unlock disk";
    label_image = Image.Text(label_text, 0.9, 0.9, 0.95, 1);
    label.sprite.SetImage(label_image);
    label.sprite.SetX(screen_width / 2 - label_image.GetWidth() / 2);
    label.sprite.SetY(entry.y - 30);
    label.sprite.SetOpacity(1);

    # Bullets sit one layer above the box (entry is Z=50) and start from the
    # box's inner-left, clamped to what fits — a long passphrase no longer
    # spills past the edge or hides behind the box looking dark.
    bullet_spacing = 18;
    box_pad = 14;
    inner_left = entry.x + box_pad;
    inner_width = entry.image.GetWidth() - box_pad * 2;
    max_visible = Math.Int(inner_width / bullet_spacing);
    bullet_y = entry.y + entry.image.GetHeight() / 2 - bullet_image.GetHeight() / 2;

    # Once the field fills, slide a window of the most recent dots leftward so
    # continued typing (e.g. a 25-char recovery key) visibly registers instead
    # of sitting full and static. Below max_visible this is plain left-align.
    overflow = num_bullets - max_visible;
    if (overflow < 0) overflow = 0;
    scroll_chars = Math.Int(overflow / 2);
    frac = (overflow - scroll_chars * 2) / 2;   # 0 or 0.5: a half-cell nudge per char

    visible = num_bullets;
    if (visible > max_visible) visible = max_visible;

    for (i = 0; i < MAX_BULLETS; i++) {
        char_index = scroll_chars + i;
        if (i < visible && char_index < num_bullets) {
            x = inner_left + (i - frac) * bullet_spacing;
            bullets[i].sprite.SetPosition(x, bullet_y, 51);
            bullets[i].sprite.SetOpacity(1);
        } else {
            bullets[i].sprite.SetOpacity(0);
        }
    }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun quit_callback() {
    logo.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
    label.sprite.SetOpacity(0);
    message_sprite.SetOpacity(0);
    caps_sprite.SetOpacity(0);
    for (i = 0; i < 8; i++) {
        spinner.dots[i].sprite.SetOpacity(0);
        spinner.white_dots[i].sprite.SetOpacity(0);
    }
    for (i = 0; i < MAX_BULLETS; i++) {
        bullets[i].sprite.SetOpacity(0);
    }
}

Plymouth.SetQuitFunction(quit_callback);
