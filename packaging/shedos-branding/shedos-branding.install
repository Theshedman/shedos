# shedos-branding install scriptlet

post_install() {
    # Point Plymouth at the shedos theme. -R regenerates the initramfs so
    # the splash shows on next boot. Tolerate failure (missing plymouth-set-
    # default-theme, read-only fs, etc.) rather than aborting the install.
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme -R shedos || \
            echo "Plymouth theme activation failed — run manually:" \
                 "plymouth-set-default-theme -R shedos"
    fi
}

post_upgrade() {
    post_install
}
