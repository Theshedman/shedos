# shellcheck shell=bash
# shedos-branding install scriptlet

post_install() {
    # Skip -R during pacstrap: shedos-branding can install before the
    # kernel's mkinitcpio presets exist, so /etc/mkinitcpio.d is empty and
    # `mkinitcpio -P` would error. Just write the theme config; the kernel's
    # own postinstall runs mkinitcpio -P later and picks the theme up then.
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        if compgen -G '/etc/mkinitcpio.d/*.preset' >/dev/null 2>&1; then
            plymouth-set-default-theme -R shedos || true
        else
            plymouth-set-default-theme shedos || true
        fi
    fi
}

post_upgrade() {
    post_install
}
