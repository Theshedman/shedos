# Maintainer: ShedOS <https://github.com/theshedman/shedos>
#
# Visual identity: Plymouth boot splash, wallpapers (incl. dusk.png shared
# by both desktop and the greetd greeter), /etc/shedos-ascii.txt (used by
# fastfetch).

pkgname=shedos-branding
pkgver=2026.05.04
pkgrel=1
pkgdesc='ShedOS visual identity: Plymouth theme, wallpapers, ASCII logo'
arch=('any')
url='https://github.com/theshedman/shedos'
license=('GPL-3.0-or-later')
depends=(
    'plymouth'
)
backup=(
    'etc/shedos-ascii.txt'
)
install=shedos-branding.install

package() {
    cd "$startdir"

    install -d "$pkgdir/usr/share/plymouth/themes/shedos"
    cp -a tree/usr/share/plymouth/themes/shedos/. \
        "$pkgdir/usr/share/plymouth/themes/shedos/"

    install -d "$pkgdir/usr/share/shedos/wallpapers"
    cp -a tree/usr/share/shedos/wallpapers/. \
        "$pkgdir/usr/share/shedos/wallpapers/"

    install -Dm644 tree/etc/shedos-ascii.txt \
        "$pkgdir/etc/shedos-ascii.txt"
}
