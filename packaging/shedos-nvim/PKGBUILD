# Maintainer: ShedOS <https://github.com/Theshedman/shedos>
#
# ShedOS default Neovim config. Split off from shedos-hyprland because:
#   1. nvim config is heavily user-modified; conservative sync is mandatory.
#      The accompanying sync-policy file instructs shedos-sync-configs to
#      always drop .shedosnew instead of auto-merging (even when the user
#      hasn't touched the file), preventing a bad upgrade from breaking
#      the editor on next launch.
#   2. lazy.nvim writes lazy-lock.json into ~/.config/nvim/ at runtime;
#      that's user state, not our config. shedos-sync-configs' exclusion
#      list skips it.
#   3. Power users should be able to `pacman -R shedos-nvim` and keep the
#      rest of ShedOS.

pkgname=shedos-nvim
pkgver=2026.05.17
pkgrel=2
pkgdesc='ShedOS default Neovim configuration (LazyVim-based)'
arch=('any')
url='https://github.com/Theshedman/shedos'
license=('GPL-3.0-or-later')
# Ships a per-user one-shot (shedos-nvim-migrate.service) that swaps an old
# ShedOS nvim config for the rebuilt LazyVim one on first login, backing the
# old one up — the conservative 3-way sync can't handle a wholesale rewrite.
install=shedos-nvim.install
depends=(
    'neovim'
    'git'
)
makedepends=(
    'rust'
    'tree-sitter-cli'
    'python'
    'gcc'
)
optdepends=(
    'clang: C/C++ language server (clangd), used from the system'
    'rust: rust-analyzer language server, used from the system'
    'nodejs: required by many LSPs and LazyVim plugins'
    'ripgrep: telescope live_grep'
    'fd: telescope file finder'
    'lazygit: default LazyVim git TUI'
)

build() {
    cd "$startdir"
    ../../scripts/materialize-nvim-plugins.sh \
        tree/usr/share/shedos/nvim/runtime \
        tree/etc/skel/.config/nvim \
        "$srcdir/nvim-shipped"
}

package() {
    cd "$startdir"

    # /etc/skel/.config/nvim; seed for new users via useradd -m.
    install -d "$pkgdir/etc/skel/.config"
    cp -a tree/etc/skel/.config/nvim "$pkgdir/etc/skel/.config/nvim"

    # /usr/share/shedos/nvim/defaults/.config/nvim; pristine mirror for
    # shedos-sync-configs. Path layout identical to $HOME-relative relpaths.
    install -d "$pkgdir/usr/share/shedos/nvim/defaults/.config"
    cp -a tree/etc/skel/.config/nvim \
        "$pkgdir/usr/share/shedos/nvim/defaults/.config/nvim"

    # System-owned editor architecture; the skel shim loads this and it
    # updates with the package on every machine.
    cp -a tree/usr/share/shedos/nvim/runtime \
        "$pkgdir/usr/share/shedos/nvim/runtime"

    # The pinned plugin set, .git-stripped, plus the generated overlay
    # that binds each spec to its shipped directory.
    cp -a "$srcdir/nvim-shipped/plugins" "$pkgdir/usr/share/shedos/nvim/plugins"
    install -Dm644 "$srcdir/nvim-shipped/shipped.lua" \
        "$pkgdir/usr/share/shedos/nvim/shipped.lua"

    # Per-package sync policy.
    install -Dm644 tree/usr/share/shedos/nvim/sync-policy \
        "$pkgdir/usr/share/shedos/nvim/sync-policy"

    # Per-user migration one-shot: cleanly swap an old ShedOS nvim config
    # for the rebuilt LazyVim one (the 3-way sync can't handle the 79->12
    # file restructure). Enabled --global by shedos-nvim.install.
    install -Dm755 tree/usr/lib/shedos/migrate-nvim-config \
        "$pkgdir/usr/lib/shedos/migrate-nvim-config"
    install -Dm644 tree/usr/lib/systemd/user/shedos-nvim-migrate.service \
        "$pkgdir/usr/lib/systemd/user/shedos-nvim-migrate.service"

    # Preserve XDG_CONFIG_HOME across sudo so `sudo nvim` reads the
    # invoking user's ~/.config/nvim/. Mode 0440 is what sudo demands.
    install -Dm0440 tree/etc/sudoers.d/shedos-nvim \
        "$pkgdir/etc/sudoers.d/shedos-nvim"
}
