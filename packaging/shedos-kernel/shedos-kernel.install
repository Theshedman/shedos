# Starting at pkgrel 2, /boot/vmlinuz-shedos-kernel is package-owned.
# Existing systems have the file there from mkinitcpio's install hook
# (untracked); clear it so pacman can claim the path without hitting a
# "file exists in filesystem" conflict.

pre_upgrade() {
    if [[ -f /boot/vmlinuz-shedos-kernel ]] && \
       ! pacman -Qoq /boot/vmlinuz-shedos-kernel &>/dev/null; then
        rm -f /boot/vmlinuz-shedos-kernel
    fi
}
