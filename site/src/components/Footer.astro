---
import { STABLE_VERSION } from "~/generated/version";
const year = new Date().getUTCFullYear();
---
<footer class="mt-20 border-t border-[var(--color-border)] bg-[var(--color-surface)]">
    <div
        class="mx-auto flex max-w-[72rem] flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between"
    >
        <div class="text-sm text-[color:var(--color-muted)]">
            &copy; {year} ShedOS &middot; GPL-3.0{STABLE_VERSION && (
                <>
                    {" "}&middot; current:
                    <code class="font-mono text-[color:var(--color-text)]">v{STABLE_VERSION}</code>
                </>
            )}
        </div>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
            <li><a href="/features">Features</a></li>
            <li><a href="/compare">Compare</a></li>
            <li><a href="/docs">Docs</a></li>
            <li><a href="/download">Download</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/changelog">Changelog</a></li>
            <li><a href="/community">Community</a></li>
            <li><a href="https://github.com/Theshedman/shedos" rel="noopener">GitHub</a></li>
        </ul>
    </div>
</footer>
