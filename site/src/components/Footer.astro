---
import { STABLE_VERSION } from "~/generated/version.ts";
const GH = "https://github.com/Theshedman/shedos";
---
<footer class="footer"><div class="container footer-inner">
    <div class="footer-brand">
        <img class="logo-dark" src="/assets/logo-wordmark-color.png" alt="ShedOS" />
        <img class="logo-light" src="/assets/logo-wordmark-white.png" alt="ShedOS" />
        <p>The operating system for software developers. Editors, runtimes, containers, and a tiling desktop, configured out of the box — every update reversible.</p>
    </div>
    <div class="footer-col"><h4>Product</h4><ul>
        <li><a href="/features">Features</a></li><li><a href="/compare">Compare</a></li>
        <li><a href="/download">Download</a></li><li><a href="/changelog">Changelog</a></li>
    </ul></div>
    <div class="footer-col"><h4>Resources</h4><ul>
        <li><a href="/docs">Docs</a></li><li><a href="/about">About</a></li>
        <li><a href="/community">Community</a></li><li><a href={GH} rel="noopener">GitHub</a></li>
    </ul></div>
</div>
<div class="footer-bar"><div class="container footer-bar-inner">
    <div>&copy; 2026 ShedOS &middot; GPL-3.0 &middot; current <code>v{STABLE_VERSION}</code></div>
    <div class="mono">Optimized for development.</div>
</div></div></footer>
