---
// Runs inline in <head> before paint to avoid FOUC.
// Honors saved choice in localStorage.theme; falls back to system preference.
---
<script is:inline>
    (function () {
        try {
            const stored = localStorage.getItem("theme");
            const prefersDark =
                window.matchMedia &&
                window.matchMedia("(prefers-color-scheme: dark)").matches;
            const shouldDark = stored ? stored === "dark" : prefersDark;
            document.documentElement.classList.toggle("dark", shouldDark);
        } catch (_) {
            /* localStorage blocked — fall through to system preference via CSS */
        }
    })();

    document.addEventListener("click", function (e) {
        const btn = e.target && e.target.closest && e.target.closest("[data-theme-toggle]");
        if (!btn) return;
        const isDark = document.documentElement.classList.toggle("dark");
        try {
            localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch (_) { /* noop */ }
    });
</script>
