---
import Logo from "./Logo.astro";
import ToggleTheme from "./ToggleTheme.astro";

const links = [
    { href: "/docs", label: "Docs" },
    { href: "/download", label: "Download" },
    { href: "/about", label: "About" },
];

const pathname = new URL(Astro.request.url).pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
    href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(href + "/");
---
<header
    class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg)_88%,transparent)] backdrop-blur"
>
    <nav
        class="mx-auto flex h-14 max-w-[72rem] items-center justify-between px-4 sm:px-6"
        aria-label="Primary"
    >
        <a href="/" class="flex items-center gap-2" aria-label="ShedOS home">
            <Logo variant="wordmark" height={24} />
        </a>

        <ul class="flex items-center gap-1 text-sm">
            {
                links.map((l) => (
                    <li>
                        <a
                            href={l.href}
                            class:list={[
                                "rounded-md px-3 py-1.5 transition",
                                isActive(l.href)
                                    ? "text-[color:var(--color-text)] font-medium"
                                    : "text-[color:var(--color-muted)] hover:text-[color:var(--color-text)]",
                            ]}
                            aria-current={isActive(l.href) ? "page" : undefined}
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
            <li class="ml-1 flex items-center">
                <ToggleTheme />
            </li>
            <li class="ml-1">
                <a
                    href="https://github.com/theshedman/shedos"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[var(--color-border-2)] text-[color:var(--color-muted)] transition hover:border-[var(--color-primary)] hover:text-[color:var(--color-primary)]"
                    aria-label="ShedOS on GitHub"
                    rel="noopener"
                >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.93c.57.1.78-.25.78-.55v-2.08c-3.2.7-3.87-1.37-3.87-1.37-.53-1.35-1.3-1.71-1.3-1.71-1.06-.72.08-.7.08-.7 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.76.41-1.27.75-1.56-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.07 0 0 .97-.31 3.19 1.18a11 11 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.64 1.6.24 2.77.12 3.07.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.42.36.8 1.08.8 2.18v3.23c0 .31.2.67.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/>
                    </svg>
                </a>
            </li>
        </ul>
    </nav>
</header>
