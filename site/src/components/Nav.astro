---
import ThemeToggle from "~/components/ThemeToggle.astro";
const GH = "https://github.com/Theshedman/shedos";
const LINKS = [["/features","Features"],["/compare","Compare"],["/docs","Docs"],["/download","Download"],["/about","About"]];
const MLINKS = [...LINKS, ["/changelog","Changelog"], ["/community","Community"]];
const path = Astro.url.pathname.replace(/(.+)\/$/, "$1");
const active = (href: string) => href === "/docs" ? (path === "/docs" || path.startsWith("/docs/")) : path === href;
---
<header class="nav"><div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="ShedOS home">
        <img class="logo-dark" src="/assets/logo-wordmark-color.png" alt="ShedOS" />
        <img class="logo-light" src="/assets/logo-wordmark-white.png" alt="ShedOS" />
    </a>
    <nav class="nav-links" aria-label="Primary">
        {LINKS.map(([href, label]) => (
            <a href={href} class={active(href) ? "active" : undefined}>{label}</a>
        ))}
    </nav>
    <div class="nav-right">
        <ThemeToggle />
        <a class="icon-btn" href={GH} aria-label="ShedOS on GitHub" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.93c.57.1.78-.25.78-.55v-2.08c-3.2.7-3.87-1.37-3.87-1.37-.53-1.35-1.3-1.71-1.3-1.71-1.06-.72.08-.7.08-.7 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.76.41-1.27.75-1.56-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.07 0 0 .97-.31 3.19 1.18a11 11 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.64 1.6.24 2.77.12 3.07.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.42.36.8 1.08.8 2.18v3.23c0 .31.2.67.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg></a>
        <button class="icon-btn nav-burger" data-burger aria-label="Open menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    </div>
</div>
<div class="mobile-menu" data-mobile-menu><ul>
    {MLINKS.map(([href, label]) => (
        <li><a href={href}>{label}</a></li>
    ))}
</ul></div>
</header>
