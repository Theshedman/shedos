---
interface Props {
    kind?: "info" | "warn" | "note";
    title?: string;
}
const { kind = "info", title } = Astro.props;

const tone = {
    info: { bar: "var(--color-primary)", label: "Info" },
    warn: { bar: "var(--color-alert)", label: "Warning" },
    note: { bar: "var(--color-muted)", label: "Note" },
}[kind];
---
<aside
    class="my-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-4 text-sm"
    role="note"
>
    <div class="flex items-center gap-2 font-semibold" style={`color: ${tone.bar}`}>
        <span aria-hidden="true" class="inline-block h-2 w-2 rounded-full" style={`background: ${tone.bar}`}></span>
        {title ?? tone.label}
    </div>
    <div class="mt-2 text-[color:var(--color-text)]"><slot /></div>
</aside>
