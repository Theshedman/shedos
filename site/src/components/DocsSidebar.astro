---
import { getCollection } from "astro:content";

interface Props {
    current?: string;
}

const { current } = Astro.props;

const entries = (await getCollection("docs")).sort(
    (a, b) => a.data.order - b.data.order,
);

const sections = new Map<string, typeof entries>();
for (const e of entries) {
    const key = e.data.section;
    if (!sections.has(key)) sections.set(key, []);
    sections.get(key)!.push(e);
}
---
<aside class="docs-side">
    {[...sections.entries()].map(([label, items]) => (
        <>
            <div class="grp">{label}</div>
            {items.map((e) => (
                <a
                    href={`/docs/${e.id}`}
                    class={e.id === current ? "active" : undefined}
                    aria-current={e.id === current ? "page" : undefined}
                >
                    {e.data.title}
                </a>
            ))}
        </>
    ))}
</aside>
