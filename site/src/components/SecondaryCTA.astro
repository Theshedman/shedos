---
import { STABLE_VERSION } from "~/generated/version";
---
<section class="mx-auto max-w-[72rem] px-4 py-20 sm:px-6">
    <div
        class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-10 text-center sm:p-14"
    >
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
            Try ShedOS
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-[color:var(--color-muted)]">
            {STABLE_VERSION ? (
                <>Download v{STABLE_VERSION}, write it to a USB drive, and boot.</>
            ) : (
                <>Download the ISO, write it to a USB drive, and boot.</>
            )}
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="/download" class="btn btn-primary">Download</a>
            <a
                href="https://github.com/Theshedman/shedos"
                class="btn btn-ghost"
                rel="noopener"
            >
                Source on GitHub
            </a>
        </div>
    </div>
</section>
