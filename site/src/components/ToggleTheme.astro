---
interface Props {
    class?: string;
}
const { class: className = "" } = Astro.props;
---
<button
    type="button"
    data-theme-toggle
    aria-label="Toggle color theme"
    title="Toggle color theme"
    class:list={[
        "inline-flex h-9 w-9 items-center justify-center rounded-md border border-[var(--color-border-2)] text-[color:var(--color-muted)] transition hover:border-[var(--color-primary)] hover:text-[color:var(--color-primary)]",
        className,
    ]}
>
    <svg
        class="icon-sun h-4 w-4 dark:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>
    <svg
        class="icon-moon hidden h-4 w-4 dark:block"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
    </svg>
</button>
