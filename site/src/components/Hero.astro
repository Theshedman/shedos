---
import { STABLE_VERSION } from "~/generated/version";
---
<section class="relative overflow-hidden">
    <div
        class="pointer-events-none absolute inset-0 -z-10 opacity-60 dark:opacity-80"
        aria-hidden="true"
    >
        <div
            class="absolute left-1/2 top-[-10%] h-[28rem] w-[58rem] -translate-x-1/2 rounded-full blur-3xl"
            style="background: radial-gradient(closest-side, rgba(0,127,255,0.18), transparent 70%)"
        ></div>
    </div>

    <div class="mx-auto max-w-[72rem] px-4 pt-20 pb-16 sm:px-6 sm:pt-28 sm:pb-24">
        <div class="max-w-3xl">
            {STABLE_VERSION && (
                <div
                    class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs text-[color:var(--color-muted)]"
                >
                    <span
                        aria-hidden="true"
                        class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"
                    ></span>
                    <span class="font-mono text-[color:var(--color-text)]">v{STABLE_VERSION}</span>
                    <span class="h-3 w-px bg-[var(--color-border-2)]"></span>
                    <span>Stable</span>
                </div>
            )}

            <h1
                class="text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl"
            >
                A developer-first<br />
                Linux, <span style="color: var(--color-primary)">built for work</span>.
            </h1>

            <p
                class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-muted)]"
            >
                ShedOS is an Arch-based distribution tuned for performance and
                ease-of-use. Editors, language toolchains, and containers ship
                out of the box — open a terminal and start building.
            </p>

            <div class="mt-10 flex flex-col gap-3 sm:flex-row">
                <a href="/download" class="btn btn-primary">
                    <svg
                        viewBox="0 0 20 20"
                        width="18"
                        height="18"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path d="M10 3a1 1 0 0 1 1 1v7.586l2.293-2.293a1 1 0 0 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L9 11.586V4a1 1 0 0 1 1-1Zm-6 12a1 1 0 0 1 1-1h10a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1Z" />
                    </svg>
                    Download
                </a>
                <a href="#features" class="btn btn-ghost">Learn more</a>
            </div>
        </div>
    </div>
</section>
