---
import features from "~/content/data/features.json";

const iconPaths: Record<string, string> = {
    terminal: "M4 6h16v12H4zM7 10l3 2-3 2M11 14h6",
    layout: "M3 5h18v14H3zM3 10h18M10 10v9",
    refresh: "M3 12a9 9 0 0 1 15-6.7L21 8M21 12a9 9 0 0 1-15 6.7L3 16M21 3v5h-5M3 21v-5h5",
    shield: "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3zM9 12l2 2 4-4",
};
---
<section id="features" class="scroll-mt-16">
    <div class="mx-auto max-w-[72rem] px-4 py-20 sm:px-6">
        <div class="mb-12 max-w-2xl">
            <p
                class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-primary)]"
            >
                Features
            </p>
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
                Built for developers, out of the box.
            </h2>
            <p class="mt-4 text-[color:var(--color-muted)]">
                ShedOS bundles a working desktop, a working toolchain, and a
                working upgrade path so you can spend your time building,
                not configuring.
            </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
            {
                features.map((f) => (
                    <article class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
                        <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--color-border-2)] bg-[var(--color-bg)] text-[color:var(--color-primary)]">
                            <svg
                                viewBox="0 0 24 24"
                                width="18"
                                height="18"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d={iconPaths[f.icon] ?? iconPaths.terminal} />
                            </svg>
                        </div>
                        <h3 class="mb-2 text-lg font-semibold">{f.title}</h3>
                        <p class="text-sm leading-relaxed text-[color:var(--color-muted)]">
                            {f.body}
                        </p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
