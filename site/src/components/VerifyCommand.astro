---
interface Props {
    command: string;
}
const { command } = Astro.props;
---
<div
    class="relative rounded-lg border border-[var(--color-border)] p-4 font-mono text-sm"
    style="background: var(--color-pre-bg); color: var(--color-pre-text)"
>
    <pre class="overflow-x-auto whitespace-pre-wrap break-all"><code>{command}</code></pre>
    <button
        type="button"
        data-copy={command}
        class="copy-btn absolute right-2 top-2 rounded-md border border-[var(--color-border-2)] bg-[var(--color-surface)] px-2 py-1 text-xs text-[color:var(--color-muted)] transition hover:border-[var(--color-primary)] hover:text-[color:var(--color-primary)]"
        aria-label="Copy command"
    >
        Copy
    </button>
</div>
<script>
    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const text = btn.getAttribute("data-copy");
            if (!text) return;
            try {
                await navigator.clipboard.writeText(text);
                const old = btn.textContent;
                btn.textContent = "Copied";
                setTimeout(() => (btn.textContent = old), 1200);
            } catch {
                /* clipboard blocked */
            }
        });
    });
</script>
