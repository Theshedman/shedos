---
import { orderedDocs } from "~/lib/docs";
import BaseLayout from "./BaseLayout.astro";
import DocsSidebar from "~/components/DocsSidebar.astro";
import DocFoot from "~/components/DocFoot.astro";

interface NavLink {
    href: string;
    label: string;
}

interface Props {
    title: string;
    description?: string;
    section?: string;
    prev?: NavLink;
    next?: NavLink;
}

const { title, description, section, prev: prevProp, next: nextProp } = Astro.props;

// Derive current slug from pathname: /docs/<slug>
const pathname = Astro.url.pathname.replace(/\/$/, "");
const currentSlug = pathname.replace(/^\/docs\//, "");

// Compute prev/next from the shared section-ordered list (matches the sidebar)
const entries = await orderedDocs();
const idx = entries.findIndex((e) => e.id === currentSlug);
const prev = prevProp ?? (idx > 0
    ? { href: `/docs/${entries[idx - 1].id}`, label: entries[idx - 1].data.title }
    : undefined);
const next = nextProp ?? (idx >= 0 && idx < entries.length - 1
    ? { href: `/docs/${entries[idx + 1].id}`, label: entries[idx + 1].data.title }
    : undefined);
---
<BaseLayout title={title} description={description ?? title}>
    <section class="section" style="padding-top:2.5rem;">
        <div class="container docs-shell">
            <DocsSidebar current={currentSlug} />
            <article class="prose">
                {section && <span class="eyebrow">{section}</span>}
                <slot />
                <DocFoot prev={prev} next={next} />
            </article>
        </div>
    </section>
</BaseLayout>
