---
import BaseLayout from "./BaseLayout.astro";
import DocsSidebar from "~/components/DocsSidebar.astro";

interface Props {
    title: string;
    description?: string;
    section?: string;
}
const { title, description, section } = Astro.props;
---
<BaseLayout title={title} description={description ?? title}>
    <div class="mx-auto grid max-w-[80rem] gap-10 px-4 py-10 sm:px-6 md:grid-cols-[14rem_1fr]">
        <aside class="md:sticky md:top-20 md:self-start">
            <DocsSidebar />
        </aside>
        <article class="prose min-w-0">
            {section && (
                <div class="mb-2 text-xs uppercase tracking-wider text-[color:var(--color-primary)]">
                    {section}
                </div>
            )}
            <h1 class="!mt-0 text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
            {description && (
                <p class="!mt-3 text-lg text-[color:var(--color-muted)]">{description}</p>
            )}
            <hr />
            <slot />
        </article>
    </div>
</BaseLayout>
