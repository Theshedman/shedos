---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ChangelogEntry from "~/components/ChangelogEntry.astro";
import { RELEASES } from "~/generated/changelog";
---
<BaseLayout
  title="Changelog"
  description="What shipped in each ShedOS release."
>
  <section class="grid-bg" style="border-bottom:1px solid var(--border);">
    <div class="container page-head">
      <span class="eyebrow">Changelog</span>
      <h1 style="margin-top:.9rem;">Changelog</h1>
      <p class="lead">One entry per stable release; release candidates roll up into the stable that follows them. The same notes appear on each <a href="https://github.com/Theshedman/shedos/releases">GitHub Release</a>.</p>
    </div>
  </section>

  <section class="section" style="padding-top:2rem;">
    <div class="container" style="max-width:48rem;">

      {RELEASES.slice(0, 5).map((r, i) => (
        <ChangelogEntry release={r} latest={i === 0} />
      ))}

      <p class="muted" style="margin-top:3rem;font-size:.92rem;">Older releases and the complete history are on <a href="https://github.com/Theshedman/shedos/releases">GitHub Releases</a>.</p>
    </div>
  </section>
</BaseLayout>
