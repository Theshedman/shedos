---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Section from "~/components/Section.astro";
import Eyebrow from "~/components/Eyebrow.astro";
import MatrixTable from "~/components/MatrixTable.astro";

const matrixHead = ["Capability", "ShedOS", "Omarchy", "Garuda", "EndeavourOS", "Manjaro"];
const matrixRows = [
    { feat: "Edits survive a config update", detail: "A changed default is merged with your version, not silently overwritten", cells: ["y", "n", "n", "p", "p"] },
    { feat: "Snapshot before every upgrade", detail: "An automatic filesystem snapshot, taken on every system update", cells: ["y", "y", "y", "n", "n"] },
    { feat: "One-command rollback", detail: "Return to a previous system state, with a browsable history", cells: ["y", "y", "y", "n", "p"] },
    { feat: "Packages soak before release", detail: "Changes bake on a testing channel before stable users receive them", cells: ["y", "y", "n", "n", "y"] },
    { feat: "Declarative system state", detail: "One file describes the system; a tool reconciles to it and reports drift", cells: ["y", "n", "p", "n", "n"] },
    { feat: "Hyprland desktop by default", detail: "A configured tiling Wayland desktop, out of the box", cells: ["y", "y", "y", "n", "n"] },
    { feat: "Dev toolchain on first boot", detail: "Editors, language runtimes, and container tools preinstalled", cells: ["y", "p", "n", "n", "n"] },
    { feat: "Built-in status indicators", detail: "Surfaces pending updates, config conflicts, and hardware health", cells: ["y", "p", "p", "p", "p"] },
    { feat: "One CLI for the whole OS", detail: "A single first-party command, with man pages, for updates, rollback, theming, and health", cells: ["y", "p", "p", "n", "n"] },
    { feat: "Fully offline installer", detail: "Installs with no network access", cells: ["y", "n", "y", "y", "p"] },
    { feat: "Performance tuning by default", detail: "A Zen-class kernel, zram, auto-renicing, and power management applied, not just documented", cells: ["y", "p", "p", "p", "n"] },
    { feat: "Windows dual-boot detected", detail: "The installer finds an existing Windows install and keeps it bootable", cells: ["y", "n", "p", "p", "y"] },
    { feat: "Whole-desktop live theming", detail: "One command recolors borders, terminal, bar, notifications, lock, and greeter — no logout", cells: ["y", "y", "n", "n", "n"] },
    { feat: "Security hardening by default", detail: "AppArmor enforcing from first boot, full-disk encryption on by default, optional Secure Boot and passwordless TPM2 unlock, and password-required sudo", cells: ["y", "p", "p", "p", "p"] },
    { feat: "Signed first-party repository", detail: "The distro's own packages are GPG-signed and verified by the package manager", cells: ["y", "n", "y", "y", "y"] },
];

---
<BaseLayout
    title="Compare"
    description="How ShedOS compares to Omarchy, Garuda, EndeavourOS, and Manjaro — and to macOS and Windows."
>
  <section class="grid-bg" style="border-bottom:1px solid var(--border);">
    <div class="container page-head">
      <Eyebrow>Compare</Eyebrow>
      <h1 style="margin-top:.9rem;">How ShedOS compares</h1>
      <p class="lead">Where ShedOS stands against the developer-focused Linux distributions it's most often weighed against. Every claim about another system is taken from that project's own documentation, linked below the table.</p>
    </div>
  </section>

  <Section>
    <MatrixTable head={matrixHead} rows={matrixRows} own={1} legend />
    <p class="muted" style="margin-top:.6rem;font-size:.78rem;">
      Verified against each project's documentation, June 2026:
      <a href="https://learn.omacom.io/" rel="noopener">Omarchy</a> ·
      <a href="https://wiki.garudalinux.org/" rel="noopener">Garuda</a> ·
      <a href="https://discovery.endeavouros.com/" rel="noopener">EndeavourOS</a> ·
      <a href="https://wiki.manjaro.org/" rel="noopener">Manjaro</a>.
      Found something out of date? <a href="https://github.com/Theshedman/shedos/issues">Tell us</a>.
    </p>
  </Section>

  <Section bordered>
    <div class="section-head"><Eyebrow>Each, briefly</Eyebrow><h2>The neighbours</h2></div>
    <div class="cards cols-2" style="gap:1.6rem 3rem;">
      <div><h3 style="font-size:1.1rem;">Omarchy</h3><p class="muted" style="margin-top:.5rem;font-size:.94rem;line-height:1.6;">The closest comparison: a curated Hyprland desktop with automatic snapshots, rollback, a soak-tested channel, and live theming. The differences are config handling and trust — Omarchy has no three-way merge for your edits, no declarative system file, and no single OS-wide CLI, and its own package repository is configured to accept unsigned packages. It also installs only to a dedicated drive.</p></div>
      <div><h3 style="font-size:1.1rem;">Garuda</h3><p class="muted" style="margin-top:.5rem;font-size:.94rem;line-height:1.6;">Automatic Btrfs snapshots with boot-menu restore on a rolling base, with a gaming-oriented KDE focus and many editions (Hyprland among them). It has no config merge, no soak channel of its own, and no preinstalled developer toolchain; declarative configuration exists only through an optional Nix subsystem.</p></div>
      <div><h3 style="font-size:1.1rem;">EndeavourOS</h3><p class="muted" style="margin-top:.5rem;font-size:.94rem;line-height:1.6;">Deliberately minimal and close to upstream, with a friendly installer. Snapshots, a tiling desktop, theming, and a toolchain are left for you to add. If you want to assemble the system yourself, that is the point of it — and a fair reason to choose it over ShedOS.</p></div>
      <div><h3 style="font-size:1.1rem;">Manjaro</h3><p class="muted" style="margin-top:.5rem;font-size:.94rem;line-height:1.6;">A curated rolling release with its own staged package pipeline and an installer that detects Windows for dual-boot. Snapshots and rollback are opt-in, there is no unified CLI or declarative config, and the official editions are GNOME, KDE, and XFCE — no Hyprland.</p></div>
    </div>
  </Section>

  <Section>
    <div class="section-head"><Eyebrow>Cross-platform</Eyebrow><h2>Coming from macOS or Windows</h2><p>ShedOS next to a Mac or a Windows PC, on the things that change day to day.</p></div>
    <div class="table-wrap">
        <table class="matrix">
          <thead><tr><th></th><th class="own">ShedOS</th><th>macOS</th><th>Windows</th></tr></thead>
          <tbody>
            <tr><td class="feat">Price</td><td>Free, open source (GPL-3.0)</td><td class="muted">Included with Apple hardware</td><td class="muted">Paid license</td></tr>
            <tr><td class="feat">Runs on</td><td>Any x86_64 PC</td><td class="muted">Apple computers only</td><td class="muted">Most x86_64 PCs</td></tr>
            <tr><td class="feat">Installing software</td><td>Command line and the AUR</td><td class="muted">App Store and Homebrew</td><td class="muted">Store, winget, installers</td></tr>
            <tr><td class="feat">Tiling window manager</td><td>Default</td><td class="muted">No</td><td class="muted">No</td></tr>
            <tr><td class="feat">Reversible system updates</td><td>Snapshot and one-command rollback</td><td class="muted">No built-in rollback</td><td class="muted">System Restore (limited)</td></tr>
            <tr><td class="feat">Developer toolchain preinstalled</td><td>Yes</td><td class="muted">No</td><td class="muted">No</td></tr>
            <tr><td class="feat">Source you can read and change</td><td>Yes</td><td class="muted">No</td><td class="muted">No</td></tr>
          </tbody>
        </table>
      </div>
    <p class="muted" style="margin-top:1rem;max-width:46rem;font-size:.92rem;">One honest caveat: it is still Linux. Some macOS- or Windows-only applications won't run here — check that the tools you depend on have Linux or web versions before you switch.</p>

    <div class="callout" style="margin-top:2.5rem;border-radius:14px;padding:1.5rem 1.6rem;">
      <span class="lbl">The short version</span>
      <p style="margin:.2rem 0 0;color:var(--text-2);">ShedOS combines updates you can roll back, a testing channel, config that merges instead of overwriting, a declarative system file, and a configured developer desktop. No other system here ships that full combination.</p>
      <p style="margin-top:1rem;font-size:.94rem;"><a href="/download" style="font-weight:600;">Download the ISO</a> <span class="muted" style="margin:0 .5rem;">·</span> <a href="/docs/getting-started">Getting started</a></p>
    </div>
  </Section>
</BaseLayout>
