---
import BaseLayout from "~/layouts/BaseLayout.astro";

// Verdicts verified against each project's own documentation in June 2026
// (see the sources note below the table). ShedOS's own column reflects
// shipped features in this repository.
const Y = "✓"; // yes, by default
const P = "~"; // partial — with setup, or a different form of it
const N = "—"; // not part of it

const matrix = [
    {
        feature: "Edits survive a config update",
        detail: "A changed default is merged with your version, not silently overwritten",
        shedos: Y, omarchy: N, garuda: N, endeavour: P, manjaro: P,
    },
    {
        feature: "Snapshot before every upgrade",
        detail: "An automatic filesystem snapshot, taken on every system update",
        shedos: Y, omarchy: Y, garuda: Y, endeavour: N, manjaro: N,
    },
    {
        feature: "One-command rollback",
        detail: "Return to a previous system state, with a browsable history",
        shedos: Y, omarchy: Y, garuda: Y, endeavour: N, manjaro: P,
    },
    {
        feature: "Packages soak before release",
        detail: "Changes bake on a testing channel before stable users receive them",
        shedos: Y, omarchy: Y, garuda: N, endeavour: N, manjaro: Y,
    },
    {
        feature: "Declarative system state",
        detail: "One file describes the system; a tool reconciles to it and reports drift",
        shedos: Y, omarchy: N, garuda: P, endeavour: N, manjaro: N,
    },
    {
        feature: "Hyprland desktop by default",
        detail: "A configured tiling Wayland desktop, out of the box",
        shedos: Y, omarchy: Y, garuda: Y, endeavour: N, manjaro: N,
    },
    {
        feature: "Dev toolchain on first boot",
        detail: "Editors, language runtimes, and container tools preinstalled",
        shedos: Y, omarchy: P, garuda: N, endeavour: N, manjaro: N,
    },
    {
        feature: "Built-in status indicators",
        detail: "Surfaces pending updates, config conflicts, and hardware health",
        shedos: Y, omarchy: P, garuda: P, endeavour: P, manjaro: P,
    },
    {
        feature: "One CLI for the whole OS",
        detail: "A single first-party command, with man pages, for updates, rollback, theming, and health",
        shedos: Y, omarchy: P, garuda: P, endeavour: N, manjaro: N,
    },
    {
        feature: "Fully offline installer",
        detail: "Installs with no network access",
        shedos: Y, omarchy: N, garuda: Y, endeavour: Y, manjaro: P,
    },
    {
        feature: "Performance tuning by default",
        detail: "A Zen-class kernel, zram, auto-renicing, and power management applied, not just documented",
        shedos: Y, omarchy: P, garuda: P, endeavour: P, manjaro: N,
    },
    {
        feature: "Windows dual-boot detected",
        detail: "The installer finds an existing Windows install and keeps it bootable",
        shedos: Y, omarchy: N, garuda: P, endeavour: P, manjaro: Y,
    },
    {
        feature: "Whole-desktop live theming",
        detail: "One command recolors borders, terminal, bar, notifications, lock, and greeter — no logout",
        shedos: Y, omarchy: Y, garuda: N, endeavour: N, manjaro: N,
    },
    {
        feature: "Security hardening by default",
        detail: "AppArmor enforcing from first boot, a full-disk-encryption option, and password-required sudo",
        shedos: Y, omarchy: P, garuda: P, endeavour: P, manjaro: P,
    },
    {
        feature: "Signed first-party repository",
        detail: "The distro's own packages are GPG-signed and verified by the package manager",
        shedos: Y, omarchy: N, garuda: Y, endeavour: Y, manjaro: Y,
    },
];

const legend = [
    [Y, "yes, by default"],
    [P, "partial — with setup, or a different form of it"],
    [N, "not part of it"],
];

const cols = [
    ["ShedOS", "shedos"],
    ["Omarchy", "omarchy"],
    ["Garuda", "garuda"],
    ["EndeavourOS", "endeavour"],
    ["Manjaro", "manjaro"],
];

const sources = [
    ["Omarchy", "https://learn.omacom.io/"],
    ["Garuda", "https://wiki.garudalinux.org/"],
    ["EndeavourOS", "https://discovery.endeavouros.com/"],
    ["Manjaro", "https://wiki.manjaro.org/"],
];

const distros = [
    {
        name: "Omarchy",
        body: "The closest comparison: a curated Hyprland desktop with automatic snapshots, rollback, a soak-tested channel, and live theming. The differences are config handling and trust — Omarchy has no three-way merge for your edits, no declarative system file, and no single OS-wide CLI, and its own package repository is configured to accept unsigned packages. It also installs only to a dedicated drive.",
    },
    {
        name: "Garuda",
        body: "Automatic Btrfs snapshots with boot-menu restore on a rolling base, with a gaming-oriented KDE focus and many editions (Hyprland among them). It has no config merge, no soak channel of its own, and no preinstalled developer toolchain; declarative configuration exists only through an optional Nix subsystem.",
    },
    {
        name: "EndeavourOS",
        body: "Deliberately minimal and close to upstream, with a friendly installer. Snapshots, a tiling desktop, theming, and a toolchain are left for you to add. If you want to assemble the system yourself, that is the point of it — and a fair reason to choose it over ShedOS.",
    },
    {
        name: "Manjaro",
        body: "A curated rolling release with its own staged package pipeline and an installer that detects Windows for dual-boot. Snapshots and rollback are opt-in, there is no unified CLI or declarative config, and the official editions are GNOME, KDE, and XFCE — no Hyprland.",
    },
];

const crossOs = [
    ["Price", "Free, open source (GPL-3.0)", "Included with Apple hardware", "Paid license"],
    ["Runs on", "Any x86_64 PC", "Apple computers only", "Most x86_64 PCs"],
    ["Installing software", "Command line and the AUR", "App Store and Homebrew", "Store, winget, installers"],
    ["Tiling window manager", "Default", "No", "No"],
    ["Reversible system updates", "Snapshot and one-command rollback", "No built-in rollback", "System Restore (limited)"],
    ["Developer toolchain preinstalled", "Yes", "No", "No"],
    ["Source you can read and change", "Yes", "No", "No"],
];
---
<BaseLayout
    title="Compare"
    description="How ShedOS compares to Omarchy, Garuda, EndeavourOS, and Manjaro — and to macOS and Windows."
>
    <article class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <h1 class="text-3xl font-bold tracking-tight">How ShedOS compares</h1>
        <p class="mt-3 max-w-3xl text-[color:var(--color-muted)]">
            Where ShedOS stands against the developer-focused Linux
            distributions it's most often weighed against. Every claim about
            another system is taken from that project's own documentation,
            linked below the table.
        </p>

        <div class="mt-10 overflow-x-auto">
            <table class="w-full border-collapse text-sm">
                <thead>
                    <tr class="border-b-2 border-[var(--color-border)] text-left">
                        <th class="py-3 pr-4 font-semibold">Capability</th>
                        {cols.map(([label], i) => (
                            <th
                                class:list={[
                                    "py-3 px-3 text-center font-semibold",
                                    i === 0 && "text-[color:var(--color-primary)]",
                                ]}
                            >
                                {label}
                            </th>
                        ))}
                    </tr>
                </thead>
                <tbody>
                    {matrix.map((r) => (
                        <tr class="border-b border-[var(--color-border)] align-top">
                            <td class="py-3 pr-4">
                                <div class="font-medium">{r.feature}</div>
                                <div class="mt-1 text-xs text-[color:var(--color-muted)]">{r.detail}</div>
                            </td>
                            {cols.map(([, key], i) => (
                                <td
                                    class:list={[
                                        "py-3 px-3 text-center text-lg",
                                        i !== 0 && "text-[color:var(--color-muted)]",
                                    ]}
                                >
                                    {r[key as keyof typeof r]}
                                </td>
                            ))}
                        </tr>
                    ))}
                </tbody>
            </table>
            <p class="mt-3 text-xs text-[color:var(--color-muted)]">
                {legend.map(([sym, text]) => (
                    <span class="mr-4"><span class="font-mono">{sym}</span> {text}</span>
                ))}
            </p>
            <p class="mt-2 text-xs text-[color:var(--color-muted)]">
                Verified against each project's documentation, June 2026:
                {sources.map(([name, url], i) => (
                    <>
                        {i > 0 && <span> · </span>}
                        <a class="underline" href={url} rel="noopener">{name}</a>
                    </>
                ))}. Found something out of date? <a class="underline" href="https://github.com/Theshedman/shedos/issues">Tell us</a>.
            </p>
        </div>

        <h2 class="mt-16 text-2xl font-semibold tracking-tight">Each, briefly</h2>
        <div class="mt-6 space-y-6 max-w-3xl">
            {distros.map((d) => (
                <div>
                    <h3 class="font-semibold">{d.name}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-[color:var(--color-muted)]">{d.body}</p>
                </div>
            ))}
        </div>

        <h2 class="mt-16 text-2xl font-semibold tracking-tight">Coming from macOS or Windows</h2>
        <p class="mt-3 max-w-3xl text-[color:var(--color-muted)]">
            ShedOS next to a Mac or a Windows PC, on the things that change day
            to day.
        </p>
        <div class="mt-6 overflow-x-auto">
            <table class="w-full border-collapse text-sm">
                <thead>
                    <tr class="border-b-2 border-[var(--color-border)] text-left">
                        <th class="py-3 pr-4 font-semibold"></th>
                        <th class="py-3 px-3 font-semibold text-[color:var(--color-primary)]">ShedOS</th>
                        <th class="py-3 px-3 font-semibold">macOS</th>
                        <th class="py-3 px-3 font-semibold">Windows</th>
                    </tr>
                </thead>
                <tbody>
                    {crossOs.map(([dim, s, m, w]) => (
                        <tr class="border-b border-[var(--color-border)] align-top">
                            <td class="py-3 pr-4 font-medium">{dim}</td>
                            <td class="py-3 px-3 text-[color:var(--color-text)]">{s}</td>
                            <td class="py-3 px-3 text-[color:var(--color-muted)]">{m}</td>
                            <td class="py-3 px-3 text-[color:var(--color-muted)]">{w}</td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
        <p class="mt-4 max-w-3xl text-sm text-[color:var(--color-muted)]">
            One honest caveat: it is still Linux. Some macOS- or Windows-only
            applications won't run here — check that the tools you depend on
            have Linux or web versions before you switch.
        </p>

        <div class="mt-16 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
            <h2 class="text-lg font-semibold">The short version</h2>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-muted)]">
                ShedOS combines updates you can roll back, a testing channel,
                config that merges instead of overwriting, a declarative system
                file, and a configured developer desktop. No other system here
                ships that full combination.
            </p>
            <p class="mt-4 text-sm">
                <a class="font-medium text-[color:var(--color-primary)] underline" href="/download">Download the ISO</a>
                <span class="mx-2 text-[color:var(--color-muted)]">·</span>
                <a class="underline" href="/docs/getting-started">Getting started</a>
            </p>
        </div>
    </article>
</BaseLayout>
