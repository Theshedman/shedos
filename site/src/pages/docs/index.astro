---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Eyebrow from "~/components/Eyebrow.astro";
import CardGrid from "~/components/CardGrid.astro";
---
<BaseLayout
  title="Docs"
  description="Documentation for ShedOS — install it, keep it up to date, and learn the shortcuts that make the desktop fast."
>

  <section class="grid-bg" style="border-bottom:1px solid var(--border);">
    <div class="container page-head">
      <Eyebrow>Documentation</Eyebrow>
      <h1 style="margin-top:.9rem;">Everything you need to run ShedOS.</h1>
      <p class="lead">Install it, keep it up to date, and learn the shortcuts that make the desktop fast.</p>
    </div>
  </section>

  <section class="section" style="padding-top:3rem;">
    <div class="container">
      <a href="/docs/getting-started" class="card linkcard" style="display:block;border-radius:18px;padding:2.5rem;">
        <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.8rem;">
          <span class="ico" style="margin:0;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l8-8 4 4-8 8H3v-4z"/><path d="M13 3l4 4"/></svg></span>
          <Eyebrow noRule>Start here</Eyebrow>
        </div>
        <h2 style="font-size:1.7rem;">Getting started</h2>
        <p class="muted" style="margin-top:.6rem;max-width:40rem;">Download, flash, install, and land on a configured desktop.</p>
        <span class="card-link">Read guide →</span>
      </a>

      <h2 style="font-family:var(--font-mono);font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:3rem 0 1.2rem;">Guide</h2>
      <CardGrid cols={2}>
        <a href="/docs/upgrading" class="card linkcard">
          <h3>Upgrading</h3>
          <p>Rolling updates, dotfile merges, and conflict review.</p>
          <span class="card-link">Read →</span>
        </a>
        <a href="/docs/faq" class="card linkcard">
          <h3>FAQ</h3>
          <p>What ShedOS is, what makes it different, and the questions switchers actually ask.</p>
          <span class="card-link">Read →</span>
        </a>
      </CardGrid>

      <h2 style="font-family:var(--font-mono);font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:2.5rem 0 1.2rem;">Security</h2>
      <CardGrid cols={3}>
        <a href="/docs/encryption" class="card linkcard">
          <h3>Disk encryption</h3>
          <p>Encrypted by default — your two keys, unlocking at boot, and recovery.</p>
          <span class="card-link">Read →</span>
        </a>
        <a href="/docs/secure-boot" class="card linkcard">
          <h3>Secure Boot</h3>
          <p>Sign the boot chain with a key of your own and turn Secure Boot on.</p>
          <span class="card-link">Read →</span>
        </a>
        <a href="/docs/tpm-unlock" class="card linkcard">
          <h3>Passwordless unlock</h3>
          <p>Bind the disk to the TPM2 so it unlocks without a passphrase — and the tradeoff.</p>
          <span class="card-link">Read →</span>
        </a>
      </CardGrid>

      <h2 style="font-family:var(--font-mono);font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:2.5rem 0 1.2rem;">Reference</h2>
      <CardGrid cols={3}>
        <a href="/docs/keybindings" class="card linkcard">
          <h3>Keybindings</h3>
          <p>Every keyboard shortcut and touchpad gesture that ships with the desktop.</p>
          <span class="card-link">Read →</span>
        </a>
        <a href="/docs/commands" class="card linkcard">
          <h3>Commands</h3>
          <p>CLI reference — shedman, pacman, and yay on ShedOS.</p>
          <span class="card-link">Read →</span>
        </a>
        <a href="/docs/hardware" class="card linkcard">
          <h3>Hardware</h3>
          <p>System requirements and hardware compatibility.</p>
          <span class="card-link">Read →</span>
        </a>
      </CardGrid>

      <div class="cta-band" style="margin-top:3.5rem;text-align:left;padding:2.2rem;">
        <div style="display:flex;flex-wrap:wrap;gap:1.5rem;align-items:center;justify-content:space-between;">
          <div>
            <h2 style="font-size:1.3rem;">Missing something?</h2>
            <p style="margin:.5rem 0 0;max-width:34rem;">Open an issue on GitHub if something in the docs is wrong, unclear, or missing. Pull requests welcome.</p>
          </div>
          <div class="pill-row">
            <a href="https://github.com/Theshedman/shedos/issues" class="btn btn-ghost" rel="noopener">Open an issue</a>
            <a href="https://github.com/Theshedman/shedos" class="btn btn-ghost" rel="noopener">Source on GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
