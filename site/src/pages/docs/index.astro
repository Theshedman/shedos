---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const iconFor: Record<string, string> = {
    "getting-started":
        '<path d="M3 12l8-8 4 4-8 8H3v-4z"/><path d="M13 3l4 4"/>',
    upgrading: '<path d="M12 4v12"/><path d="M6 10l6-6 6 6"/><path d="M4 20h16"/>',
    keybindings:
        '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h.01"/><path d="M11 10h.01"/><path d="M15 10h.01"/><path d="M7 14h10"/>',
};

const entries = (await getCollection("docs")).sort(
    (a, b) => a.data.order - b.data.order,
);

const featured = entries.find((e) => e.id === "getting-started") ?? entries[0];
const rest = entries.filter((e) => e !== featured);

const grouped = rest.reduce<Record<string, typeof rest>>((acc, e) => {
    (acc[e.data.section] ??= []).push(e);
    return acc;
}, {});

const sectionOrder = ["Guide", "Reference"];
const sections = Object.keys(grouped).sort((a, b) => {
    const ai = sectionOrder.indexOf(a);
    const bi = sectionOrder.indexOf(b);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});
---
<BaseLayout title="Docs" description="Documentation for ShedOS.">
    <div class="mx-auto max-w-[72rem] px-4 pt-16 pb-20 sm:px-6">
        <header class="max-w-2xl">
            <div class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-primary)]">
                Documentation
            </div>
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
                Everything you need to run ShedOS.
            </h1>
            <p class="mt-4 text-[color:var(--color-muted)]">
                Install it, keep it up to date, and learn the shortcuts that
                make the desktop fast.
            </p>
        </header>

        {featured && (
            <a
                href={`/docs/${featured.id}`}
                class="group mt-12 block overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 transition hover:border-[var(--color-primary)] sm:p-10"
            >
                <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-center">
                    <div>
                        <div class="mb-3 flex items-center gap-2">
                            <span
                                class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-primary)]/10 text-[color:var(--color-primary)]"
                                aria-hidden="true"
                            >
                                <svg
                                    viewBox="0 0 24 24"
                                    width="20"
                                    height="20"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    set:html={iconFor[featured.id] ?? ""}
                                />
                            </span>
                            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-primary)]">
                                Start here
                            </span>
                        </div>
                        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
                            {featured.data.title}
                        </h2>
                        <p class="mt-3 max-w-xl text-[color:var(--color-muted)]">
                            {featured.data.description}
                        </p>
                    </div>
                    <div class="flex items-center gap-2 text-sm font-semibold text-[color:var(--color-primary)] transition group-hover:translate-x-1">
                        Read guide
                        <svg
                            viewBox="0 0 20 20"
                            width="16"
                            height="16"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path d="M10.293 3.293a1 1 0 0 1 1.414 0l5 5a1 1 0 0 1 0 1.414l-5 5a1 1 0 1 1-1.414-1.414L13.586 10 10.293 6.707a1 1 0 0 1 0-1.414z" />
                            <path d="M3 10a1 1 0 0 1 1-1h11a1 1 0 1 1 0 2H4a1 1 0 0 1-1-1z" />
                        </svg>
                    </div>
                </div>
            </a>
        )}

        {sections.map((section) => (
            <section class="mt-14">
                <h2 class="mb-5 text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-muted)]">
                    {section}
                </h2>
                <div class="grid gap-4 sm:grid-cols-2">
                    {grouped[section].map((e) => (
                        <a
                            href={`/docs/${e.id}`}
                            class="group flex items-start gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition hover:border-[var(--color-primary)]"
                        >
                            <span
                                class="mt-0.5 inline-flex h-10 w-10 flex-none items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[color:var(--color-primary)]"
                                aria-hidden="true"
                            >
                                <svg
                                    viewBox="0 0 24 24"
                                    width="20"
                                    height="20"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    set:html={iconFor[e.id] ?? iconFor["getting-started"]}
                                />
                            </span>
                            <div class="min-w-0">
                                <h3 class="text-base font-semibold text-[color:var(--color-text)]">
                                    {e.data.title}
                                </h3>
                                <p class="mt-1 text-sm text-[color:var(--color-muted)]">
                                    {e.data.description}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        ))}

        <section class="mt-16 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 sm:p-10">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-xl font-bold tracking-tight">Missing something?</h2>
                    <p class="mt-2 max-w-xl text-sm text-[color:var(--color-muted)]">
                        Open an issue on GitHub if something in the docs is
                        wrong, unclear, or missing. Pull requests welcome.
                    </p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a
                        href="https://github.com/Theshedman/shedos/issues"
                        class="btn btn-ghost"
                        rel="noopener"
                    >
                        Open an issue
                    </a>
                    <a
                        href="https://github.com/Theshedman/shedos"
                        class="btn btn-ghost"
                        rel="noopener"
                    >
                        Source on GitHub
                    </a>
                </div>
            </div>
        </section>
    </div>
</BaseLayout>
