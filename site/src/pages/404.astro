---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Btn from "~/components/Btn.astro";
---
<BaseLayout title="Not found" noindex>
  <section class="hero grid-bg" style="border-bottom:0;">
    <div class="container" style="padding:7rem 0;text-align:center;">
      <div class="mono" style="font-size:5rem;font-weight:700;color:var(--primary);letter-spacing:-.04em;">404</div>
      <h1 style="margin-top:1rem;font-size:clamp(1.6rem,4vw,2.4rem);">This page isn't on the system.</h1>
      <p class="lead" style="margin:1rem auto 0;max-width:34rem;">The page you're after has been moved or never existed. <code class="code-inline">shedman doctor</code> would have caught the drift — try one of these instead.</p>
      <div class="hero-cta" style="justify-content:center;margin-top:2.2rem;">
        <Btn href="/" variant="primary">Home</Btn>
        <Btn href="/docs" variant="ghost">Docs</Btn>
        <Btn href="/download" variant="ghost">Download</Btn>
      </div>
    </div>
  </section>
</BaseLayout>
