---
import BaseLayout from "~/layouts/BaseLayout.astro";
---
<BaseLayout title="Not found" description="This page couldn't be found.">
    <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-4 py-16 text-center sm:px-6">
        <div class="font-mono text-6xl font-bold text-[color:var(--color-primary)]">
            404
        </div>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight">Page not found</h1>
        <p class="mt-3 text-[color:var(--color-muted)]">
            The page you're looking for doesn't exist.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/" class="btn btn-primary">Home</a>
            <a href="/docs" class="btn btn-ghost">Docs</a>
            <a href="/download" class="btn btn-ghost">Download</a>
        </div>
    </section>
</BaseLayout>
