# Build artifacts
build/
out/
db-cache/
*.iso
*.sha256
# Fixture manifests are real files we want under version control — the
# sync-configs tool keys on the .sha256 extension, so we can't rename them.
!test/sync-configs/fixtures/**/*.sha256
packages/npm-cache/
packages/aur/
archiso/shedos-repo/*.pkg.tar.zst*
archiso/shedos-repo/shedos-repo.db*
archiso/shedos-repo/shedos-repo.files*
# Rendered from archiso/pacman.conf.in at build time
archiso/pacman.conf
# Rendered from archiso/airootfs/etc/pacman.conf.in at build time (channel substitution)
archiso/airootfs/etc/pacman.conf

# makepkg byproducts under packaging/<pkg>/ — pkg/ is the staging dir it
# installs into during package(); src/ holds extracted sources; the
# .pkg.tar.zst is the built artifact (CI rebuilds from PKGBUILD on every tag).
packaging/*/pkg/
packaging/*/src/
# Exception: shedos-greeter, shedos-prompt-ui, shedos-power, shedos-tour
# and shedos-switcher are single-crate Rust packages whose actual Rust
# sources live at packaging/<pkg>/src/. Without these !-rules the
# makepkg-byproduct rule above would silently un-track them.
!packaging/shedos-greeter/src/
!packaging/shedos-prompt-ui/src/
!packaging/shedos-power/src/
!packaging/shedos-tour/src/
!packaging/shedos-switcher/src/
packaging/*/*.pkg.tar.zst
packaging/*/*.pkg.tar.zst.sig
# makepkg downloads remote source tarballs (source=("…tar.gz")) to the
# package root before extracting into src/; ignore them so they don't
# get committed alongside the PKGBUILD.
packaging/*/*.tar.gz
# makepkg keeps a sibling clone cache for git+ VCS sources so subsequent
# rebuilds can `git fetch` rather than re-clone from scratch. The
# directory name matches the upstream repo basename.
packaging/shedos-hyprland-plugin-hyprspace/Hyprspace/
packaging/calamares/calamares/

# Bundled AUR .pkg.tar.zst files staged into shedos-system at build time
# by scripts/build-shedos-packages.sh, copied from archiso/shedos-repo/
# for each entry in packages/aur-bundled.txt. The directory only exists
# inside the harness's BUILD_ROOT copy of the package; this rule keeps
# stray local-makepkg leftovers from getting tracked.
packaging/shedos-system/tree/usr/share/shedos/aur-pkgs/

# Dev-only convenience: symlinked from /usr/share/calamares/qml so
# `calamares -c installer/calamares/` works without copying the QML
# tree into the repo. Calamares 3.4.x refuses to start when -c points
# at a config dir lacking qml/, even when the sequence uses zero QML
# modules. Live ISO is unaffected (no -c there).
installer/calamares/qml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
eggs/
.eggs/
*.egg
.installed.cfg
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/
env/
.env

# Node / site (site/ is an Astro project)
node_modules/
.astro/
site/src/generated/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env.local
.env.production
.env.development

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Temporary
*.tmp
*.temp
*.log

# Generated lists
packages_merged.txt

# Virtual Machine Images
*.qcow2
test/OVMF_VARS.fd
.antigravityignore

# Signing keys — private key material must never be committed. The ceremony
# script writes it to packaging/shedos-keyring/shedos-private.asc; this guard
# is defense-in-depth in case someone forgets to shred before `git add`.
packaging/shedos-keyring/shedos-private.asc
*-private.asc

# Local code-review documents. Per-session audit reports that aren't
# part of the project's durable docs.
REVIEW-*.md
